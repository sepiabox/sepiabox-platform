<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>sepiabox-apphost</UserSecretsId>
    <!-- DCP and the dashboard come from NuGet packages, so the Aspire CLI bundle is not needed. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire.Hosting brings MessagePack 2.5.302 transitively (GHSA-qhrr-8q5h-9q3h); pin the patched release. -->
    <PackageReference Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.Azure.ApplicationInsights" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.Azure.ContainerRegistry" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.Azure.KeyVault" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.Azure.OperationalInsights" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.Azure.PostgreSQL" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="13.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sepiabox.Web\Sepiabox.Web.csproj" />
    <ProjectReference Include="..\Sepiabox.Worker\Sepiabox.Worker.csproj" />
  </ItemGroup>

</Project>
