<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- The UI formats dates per culture (en, pt-BR), which needs ICU's culture data (D-050, D-058). -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- The default aspnet image has ICU; a chiseled one would need its -extra variant (D-058). Named here so
         the image azd builds cannot drift to one without it. -->
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0</ContainerBaseImage>
    <!-- In a deploy, the same image plus the CLIP text model in /models (S-056, D-071): scripts/deploy.sh sets
         SEPIABOX_WEB_BASE_IMAGE to the sepiabox-web-models image scripts/web-models.sh built on it. -->
    <ContainerBaseImage Condition="'$(SEPIABOX_WEB_BASE_IMAGE.Trim())' != ''">$(SEPIABOX_WEB_BASE_IMAGE.Trim())</ContainerBaseImage>
    <!-- OAuth clients and the access list come from user secrets locally (docs/operations.md). -->
    <UserSecretsId>sepiabox-web-553a6207-0978-4b84-ab9b-8648b5110515</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Storage.Blobs" Version="13.6.1" />
    <PackageReference Include="Aspire.Azure.Security.KeyVault" Version="13.6.1" />
    <PackageReference Include="Aspire.Npgsql" Version="13.6.1" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.4" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.4" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.77.0.4301" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sepiabox.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sepiabox.Catalog\Sepiabox.Catalog.csproj" />
    <!-- CLIP text model and tokenizer (S-016, D-055): ONNX Runtime only, never Sepiabox.Pipeline (D-038). -->
    <ProjectReference Include="..\Sepiabox.Search\Sepiabox.Search.csproj" />
    <ProjectReference Include="..\Sepiabox.ServiceDefaults\Sepiabox.ServiceDefaults.csproj" />
    <!-- Blob storage behind IBlobStore (S-050): no media libraries, so never Sepiabox.Pipeline (D-038). -->
    <ProjectReference Include="..\Sepiabox.Storage\Sepiabox.Storage.csproj" />
  </ItemGroup>

</Project>
