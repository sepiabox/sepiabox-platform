@* One person: their best face cropped from its thumbnail, their name and how many faces they have (S-019, S-020). *@

<span class="face">
    @if (Person.Cover is { } cover)
    {
        <img src="photos/@cover.AssetId/@DerivativeNames.Thumbnail" alt="" loading="lazy" style="@cover.ImageStyle()" />
    }
</span>
<span class="name">@(Person.Name ?? Text["People_Unnamed"])</span>
<span class="count muted small">@FaceCount(Person.FaceCount)</span>

@code {
    [Parameter, EditorRequired]
    public PersonSummary Person { get; set; } = default!;

    private string FaceCount(int count) =>
        count == 1 ? Text["People_Faces_One"] : Text["People_Faces_Other", count.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)];
}
