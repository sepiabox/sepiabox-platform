@using System.Globalization
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* With the app's PathBase, so every relative link in the pages stays inside the app (D-048). *@
    <base href="@BaseHref" />
    <ResourcePreloader />
    <link rel="icon" href="symbol.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Sepiabox.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    @* On every page, since enhanced navigation can bring the player in without loading the page again. *@
    <script src="@Assets["video.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string BaseHref => (HttpContext?.Request.PathBase ?? PathString.Empty) + "/";
}
