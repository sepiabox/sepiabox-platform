@using System.Globalization
@using Microsoft.AspNetCore.Diagnostics
@inject NavigationManager Navigation
@* A form post with an antiforgery token, like sign-out. It stores the choice in the culture cookie and comes back
   to this page with a full load (no enhanced form post), so every part of the page, and any circuit started
   from it, is in the new language (D-050, D-058). *@
<form class="language" method="post" action="@Action" data-enhance="false" aria-label="@Text["Language_Label"]">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
    @foreach (var (culture, name) in Choices)
    {
        <button type="submit" name="culture" value="@culture" lang="@culture" data-short="@Short(culture)" aria-label="@($"{name} ({Short(culture)})")" aria-pressed="@(IsCurrent(culture) ? "true" : "false")">@name</button>
    }
</form>

@code {
    // Relative to the page's <base>, like every other link, so it stays under the app's path base.
    private static readonly string Action = WebLocalization.SwitchPath.TrimStart('/');

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private IEnumerable<(string Culture, string Name)> Choices =>
    [
        (WebLocalization.English, Text["Language_English"]),
        (WebLocalization.BrazilianPortuguese, Text["Language_BrazilianPortuguese"]),
    ];

    /// <summary>
    /// The page the browser asked for, with the app's path base and the query, escaped as in a URL. When the
    /// not-found or error page is rendered in its place (status code pages and the exception handler run the
    /// request again under another path), the original page, so switching there does not land on /not-found.
    /// </summary>
    private string ReturnUrl
    {
        get
        {
            if (HttpContext?.Features.Get<IStatusCodeReExecuteFeature>() is { } statusCode)
            {
                return new PathString(statusCode.OriginalPathBase).Add(statusCode.OriginalPath).ToUriComponent()
                    + statusCode.OriginalQueryString;
            }

            if (HttpContext?.Features.Get<IExceptionHandlerPathFeature>() is { } error)
            {
                // The exception handler only changes the path: the path base and the query are the original ones.
                return HttpContext.Request.PathBase.Add(error.Path).ToUriComponent() + HttpContext.Request.QueryString;
            }

            return new Uri(Navigation.Uri).PathAndQuery;
        }
    }

    // EN and PT, shown by the stylesheet where the header is tight; the button's text stays the full name, and its accessible name
    // holds both, so "click PT" works for speech input (WCAG 2.5.3, label in name).
    private static string Short(string culture) => culture.Split('-')[0].ToUpperInvariant();

    private static bool IsCurrent(string culture) =>
        string.Equals(CultureInfo.CurrentUICulture.Name, culture, StringComparison.OrdinalIgnoreCase);
}
