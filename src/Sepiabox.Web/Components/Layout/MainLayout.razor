@inherits LayoutComponentBase
@inject NavigationManager Navigation

<header class="top@(IsAuthPage ? " top-bare" : "")">
    <a href="./" class="brand">
        <img src="symbol.svg" alt="" width="28" height="28" />
        <span class="wordmark"><span class="wordmark-sepia">sepia</span>box</span>
    </a>
    <div class="top-end">
        @if (!IsAuthPage)
        {
        <AuthorizeView>
            <Authorized>
                <a href="occasions" class="nav-link" aria-current="@Current("occasions")">@Text["Layout_Occasions"]</a>
                <a href="people" class="nav-link" aria-current="@Current("people")">@Text["Layout_People"]</a>
                @* The pages used now and then, in a disclosure that works without JavaScript (D-102); it says which one is open. *@
                <details class="nav-more" data-more>
                    <summary aria-label="@MoreLabel" class="nav-link@(MoreCurrent is null ? string.Empty : " nav-more-active")">@Text["Layout_More"]@if (MoreCurrent is { } current){<span class="nav-more-current">: @Text[current]</span>}</summary>
                    <div class="nav-more-list" tabindex="-1">
                        <span class="user user-in-more" title="@context.User.FindFirst(ClaimTypes.Email)?.Value">@context.User.FindFirst(ClaimTypes.Email)?.Value</span>
                        @foreach (var (href, key) in s_more)
                        {
                            <a href="@href" class="nav-link" aria-current="@Current(href)">@Text[key]</a>
                        }
                    </div>
                </details>
                <a href="settings" class="nav-link" aria-current="@Current("settings")">@Text["Layout_Settings"]</a>
                <span class="user" title="@context.User.FindFirst(ClaimTypes.Email)?.Value">@context.User.FindFirst(ClaimTypes.Email)?.Value</span>
                <SignOutButton />
            </Authorized>
        </AuthorizeView>
        }
        <LanguageSwitch />
    </div>
</header>

<main class="@(IsAuthPage ? "auth-main" : null)">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    @Text["Layout_UnexpectedError"]
    <a href="." class="reload">@Text["Layout_Reload"]</a>
    <button type="button" class="dismiss" aria-label="@Text["Layout_Dismiss"]">🗙</button>
</div>

@code {
    // The pages under "More", in the order they are listed.
    private static readonly (string Href, string Key)[] s_more =
    [
        ("organize", "Layout_Organize"),
        ("places", "Layout_Places"),
        ("sources", "Layout_Sources"),
        ("storage", "Layout_Storage"),
    ];

    // The page being shown, relative to the app's base without the query: "people" for /people and /people/3.
    private string Path
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            var end = relative.IndexOfAny(['?', '#']);
            return end < 0 ? relative : relative[..end];
        }
    }

    // The sign-in and no-access pages: their header is the brand and the language switch, nothing else (S-073).
    private bool IsAuthPage => Path is "sign-in" or "no-access";

    // "page" for the link of the page being shown (and of the pages below it), nothing for the others.
    private string? Current(string href) => string.Equals(Path, href, StringComparison.OrdinalIgnoreCase) || Path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase) ? "page" : null;

    // The resource key of the page being shown when it is one under "More", so the closed disclosure can say so.
    // The summary's accessible name: its text, and which page is current when it is one inside (a null label leaves the text).
    private string? MoreLabel => MoreCurrent is { } current ? Text["Layout_MoreCurrentLabel", Text["Layout_More"].Value, Text[current].Value].Value : null;

    private string? MoreCurrent => s_more.FirstOrDefault(m => Current(m.Href) is not null).Key;
}
