@inherits LayoutComponentBase

<header class="top">
    <a href="./" class="brand">
        <img src="symbol.svg" alt="" width="28" height="28" />
        <span>sepiabox</span>
    </a>
    <AuthorizeView>
        <Authorized>
            <span class="user">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span>
            <SignOutButton />
        </Authorized>
    </AuthorizeView>
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <button type="button" class="dismiss" aria-label="Fechar">🗙</button>
</div>
