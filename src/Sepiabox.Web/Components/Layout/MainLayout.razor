@inherits LayoutComponentBase

<header class="top">
    <a href="./" class="brand">
        <img src="symbol.svg" alt="" width="28" height="28" />
        <span class="wordmark"><span class="wordmark-sepia">sepia</span>box</span>
    </a>
    <div class="top-end">
        <AuthorizeView>
            <Authorized>
                <a href="people" class="nav-link">@Text["Layout_People"]</a>
                <a href="places" class="nav-link">@Text["Layout_Places"]</a>
                <a href="settings" class="nav-link">@Text["Layout_Settings"]</a>
                <span class="user">@context.User.FindFirst(ClaimTypes.Email)?.Value</span>
                <SignOutButton />
            </Authorized>
        </AuthorizeView>
        <LanguageSwitch />
    </div>
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    @Text["Layout_UnexpectedError"]
    <a href="." class="reload">@Text["Layout_Reload"]</a>
    <button type="button" class="dismiss" aria-label="@Text["Layout_Dismiss"]">🗙</button>
</div>
