@using System.Globalization
@using Sepiabox.Catalog.Search
@* A plain GET form: the timeline turns its fields into ?q= (SearchLinks), so it needs no interactivity. *@

<form class="filters" method="get" action="./" role="search" aria-label="@Text["Filter_Label"]">
    <input type="hidden" name="filter" value="1" />
    @if (Fields.SimilarTo is { } similar)
    {
        @* The bar narrows the photos similar to one (S-017): the photo, and how many were asked for, go with it. *@
        <input type="hidden" name="@SearchLinks.SimilarParameter" value="@similar.AssetId" />
        @if (similar.Limit is { } limit)
        {
            <input type="hidden" name="@SearchLinks.SimilarLimitParameter" value="@limit.ToString(CultureInfo.InvariantCulture)" />
        }
    }

    @if (Fields.SimilarToRegion is { } region)
    {
        @* The bar narrows the photos like a part of a photo (S-041): the photo, the part and how many were asked for go with it. *@
        <input type="hidden" name="@SearchLinks.RegionAssetParameter" value="@region.AssetId" />
        <input type="hidden" name="@SearchLinks.RegionBoxParameter" value="@SearchLinks.FormatBox(region.Box)" />
        @if (region.Limit is { } regionLimit)
        {
            <input type="hidden" name="@SearchLinks.RegionLimitParameter" value="@regionLimit.ToString(CultureInfo.InvariantCulture)" />
        }
    }

    @foreach (var eventId in Fields.EventIds)
    {
        @* The bar narrows an occasion's photos (S-023): the occasions go with it. *@
        <input type="hidden" name="@SearchLinks.EventParameter" value="@eventId.ToString(CultureInfo.InvariantCulture)" />
    }

    @if (Fields.SourceCount is { } sourceCount)
    {
        @* The bar narrows the items in one source or in several (S-028): the number of sources goes with it. *@
        @if (sourceCount.Eq is { } eq)
        {
            <input type="hidden" name="@SearchLinks.SourceEqParameter" value="@eq.ToString(CultureInfo.InvariantCulture)" />
        }
        @if (sourceCount.Gte is { } gte)
        {
            <input type="hidden" name="@SearchLinks.SourceGteParameter" value="@gte.ToString(CultureInfo.InvariantCulture)" />
        }
    }

    @if (Fields.Quality is { } quality)
    {
        @* The bar narrows the blurry (or the sharp) photos (S-027): the filter goes with it. *@
        <input type="hidden" name="@SearchLinks.BlurryParameter" value="@(quality.Blurry ? "1" : "0")" />
    }

    @if (Fields.IncludeHidden)
    {
        <input type="hidden" name="@SearchLinks.HiddenParameter" value="1" />
    }

    @* The filters are dropdown chips (S-067, D-123): the same field names as the selects they replace, so a submit gives the same
       address; without JavaScript "Apply filters" submits, with it a radio's change does. *@
    <FilterChip Label="@Text["Filter_Year"]" Set="@(Fields.Year is not null)" Value="@Fields.Year?.ToString(CultureInfo.CurrentCulture)">
        <FilterRadios Name="year" Selected="@Fields.Year?.ToString(CultureInfo.InvariantCulture)"
                      Options="@Years.Select(y => (y.ToString(CultureInfo.InvariantCulture), y.ToString(CultureInfo.CurrentCulture)))" />
    </FilterChip>

    <FilterChip Label="@Text["Filter_Month"]" Set="@(Fields.Month is not null)" Value="@(Fields.Month is { } shown ? MonthName(shown) : null)">
        <FilterRadios Name="month" Selected="@Fields.Month?.ToString(CultureInfo.InvariantCulture)"
                      Options="@Enumerable.Range(1, 12).Select(m => (m.ToString(CultureInfo.InvariantCulture), MonthName(m)))" />
    </FilterChip>

    <FilterChip Label="@Text["Filter_Kind"]" Set="@(Fields.Kind is not null)" Value="@(Fields.Kind == AssetKinds.Video ? Text["Filter_Videos"].Value : Text["Filter_Photos"].Value)">
        <FilterRadios Name="kind" Selected="@Fields.Kind"
                      Options="@(new[] { (AssetKinds.Photo, Text["Filter_Photos"].Value), (AssetKinds.Video, Text["Filter_Videos"].Value) })" />
    </FilterChip>

    <FilterChip Label="@Text["Filter_City"]" Set="@(Fields.City is not null)" Value="@Fields.City">
        <FilterRadios Name="city" Selected="@Fields.City" Options="@Cities.Select(c => (c, c))" />
    </FilterChip>

    <FilterChip Label="@Text["Filter_Source"]" Set="@(Fields.Source is not null)" Value="@Fields.Source">
        <FilterRadios Name="source" Selected="@Fields.Source" Options="@Sources.Select(c => (c, c))" />
    </FilterChip>

    @if (Albums.Any())
    {
        @* The albums exports put photos in (S-052): shown only when the catalog has some. *@
        <FilterChip Label="@Text["Filter_Album"]" Set="@(Fields.Album is not null)" Value="@Fields.Album">
            <FilterRadios Name="album" Selected="@Fields.Album" Options="@Albums.Select(c => (c, c))" />
        </FilterChip>
    }

    @if (SavedPlaces.Any())
    {
        @* The family's places (S-014): taken in any of them. *@
        <FilterChip Label="@Text["Filter_SavedPlaces"]" Set="@(Fields.SavedPlaces.Count > 0)" Value="@Summary(Fields.SavedPlaces)">
            <FilterChecks Name="place" Options="@SavedPlaces" Selected="@Fields.SavedPlaces" />
        </FilterChip>
    }

    @if (People.Any() || Options.MeLinked || Fields.Me)
    {
        @if (People.Any())
        {
            @* Several people: a photo with all of them (S-021). A search box, an avatar per person and a footer that submits. *@
            <FilterChip Label="@Text["Filter_People"]" Set="@(Fields.People.Count > 0)" Value="@Summary(Fields.People)">
                <FilterChecks Name="person" Options="@People" Selected="@Fields.People" Searchable="true" SearchPlaceholder="@Text["Filter_PeopleSearch"]">
                    <Avatar Context="name">
                        <PersonAvatar Name="@name" PersonId="@PersonKey(name)" Crop="@Cover(name)" />
                    </Avatar>
                    <Footer>
                        <a class="button secondary" href="@PeopleResetHref" data-enhance-nav="false">@Text["Filter_Reset"]</a>
                        <button type="submit" class="button">@Text["Filter_ShowResults"]</button>
                    </Footer>
                </FilterChecks>
            </FilterChip>
        }

        @if (Options.MeLinked || Fields.Me)
        {
            <label class="pill me">
                <input type="checkbox" name="me" value="1" checked="@Fields.Me" />
                <span>@Text["Filter_Me"]</span>
            </label>
        }
    }

    <a class="pill shortcut" href="@SearchLinks.Timeline(SearchLinks.OnThisDay)" aria-current="@(OnThisDayActive ? "page" : null)">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
        <span>@Text["Filter_OnThisDay"]</span>
    </a>

    @if (DescribeAvailable)
    {
        <label class="describe">
            <span>@Text["Filter_Describe"]</span>
            <input type="search" name="text" value="@Fields.Text" maxlength="@SearchQueryJson.MaxTextLength" placeholder="@Text["Filter_DescribePlaceholder"]" lang="en" />
        </label>
    }

    <span class="spacer"></span>
    <button type="submit" class="button">@Text["Filter_Apply"]</button>
    @if (Filtered)
    {
        <a class="clear" href="./">@Text["Filter_Clear"]</a>
    }
</form>

@code {
    [Parameter, EditorRequired]
    public FilterOptions Options { get; set; } = new([], [], []);

    [Parameter]
    public FilterFields Fields { get; set; } = new(null, null, null, null, null);

    [Parameter]
    public bool Filtered { get; set; }

    /// <summary>Whether the CLIP text model is there: without it, the description box is not shown (S-016).</summary>
    [Parameter]
    public bool DescribeAvailable { get; set; }

    [Parameter]
    public bool OnThisDayActive { get; set; }

    /// <summary>Where "Reset" in the people picker goes: the search without the people (S-067).</summary>
    [Parameter]
    public string PeopleResetHref { get; set; } = "./";

    // A year, city or source the URL names but the catalog lacks stays selectable, so the bar shows what is applied.
    private IEnumerable<int> Years => Fields.Year is { } year && !Options.Years.Contains(year)
        ? Options.Years.Append(year).OrderDescending()
        : Options.Years;

    private IEnumerable<string> Albums => With(Options.Albums, Fields.Album).Order(StringComparer.CurrentCultureIgnoreCase);

    private IEnumerable<string> Cities => With(Options.Cities, Fields.City);

    private IEnumerable<string> Sources => With(Options.Sources, Fields.Source);


    private IEnumerable<string> People => Fields.People.Aggregate((IEnumerable<string>)Options.People, (all, name) => With([.. all], name));

    private IEnumerable<string> SavedPlaces => Fields.SavedPlaces.Aggregate((IEnumerable<string>)Options.SavedPlaces, (all, name) => With([.. all], name));

    // What the summary says for a many-valued filter: the name when there is one, else how many.
    private string? Summary(IReadOnlyList<string> chosen) =>
        chosen.Count switch { 0 => null, 1 => chosen[0], _ => Text["Filter_Selected", chosen.Count.ToString(CultureInfo.CurrentCulture)].Value };

    // An avatar's colour follows a stable number per name; the picker has names, not ids.
    private static long PersonKey(string name) => name.Aggregate(0L, (hash, c) => (hash * 31) + c) & 0x7fffffff;

    private FaceCrop? Cover(string name) => Options.PersonCovers.GetValueOrDefault(name);

    private static IEnumerable<string> With(IReadOnlyList<string> values, string? value) =>
        value is null || values.Contains(value, StringComparer.OrdinalIgnoreCase) ? values : values.Append(value);

    // Month names come from the culture (D-050), capitalised as a list entry.
    private static string MonthName(int month)
    {
        var name = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month);
        return name.Length == 0 ? name : CultureInfo.CurrentCulture.TextInfo.ToUpper(name[0]) + name[1..];
    }
}
