@page "/people/{Id:long}/delete"
@inject ILibraryQueries Library
@inject IFaceSettings Faces
@inject NavigationManager Navigation
@* "Delete face data" asks first (S-022, D-081): the person, what goes and what stays; only this page's POST deletes. *@

<PageTitle>@Text["Delete_Title"] · Sepiabox</PageTitle>

@if (_person is null)
{
    <PageHead Title="@Text["Person_Error_NotFound"]">
        <Back><a href="people">@Text["Person_Back"]</a></Back>
    </PageHead>
}
else
{
    <PageHead Title="@Text["Delete_Title"]">
        <Back><a href="people/@_person.Id">@(_person.Name ?? Text["People_Unnamed"])</a></Back>
    </PageHead>
    <Panel Class="confirm-panel">
        <ul class="people delete-people">
            <li class="person"><PersonCard Person="Summary(_person)" /></li>
        </ul>
        <p class="note danger"><strong>@Text["Delete_Explain"]</strong></p>
        <form method="post" @formname="delete" @onsubmit="ConfirmAsync" class="confirm">
            <AntiforgeryToken />
            <input type="hidden" name="Confirmed" value="yes" />
            <a href="people/@_person.Id" class="button secondary" autofocus>@Text["Merge_Cancel"]</a>
            <button type="submit" class="button danger">@Text["Delete_Confirm"]</button>
        </form>
    </Panel>
}

@code {
    [Parameter]
    public long Id { get; set; }

    [SupplyParameterFromForm(FormName = "delete")]
    public string? Confirmed { get; set; }

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private PersonDetail? _person;

    protected override async Task OnParametersSetAsync()
    {
        _person = await Library.GetPersonAsync(Id);
        if (_person is null && HttpContext is not null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }

    private static PersonSummary Summary(PersonDetail person) =>
        new(person.Id, person.Name, person.FaceCount, person.Faces.FirstOrDefault()?.Crop);

    private async Task ConfirmAsync()
    {
        var email = HttpContext?.User.FindFirst(ClaimTypes.Email)?.Value;
        var deleted = email is not null && await Faces.DeletePersonAsync(Id, email);
        Navigation.NavigateTo(deleted ? $"people?{PersonLinks.NoteParameter}=deleted" : $"people/{Id}?{PersonLinks.NoteParameter}=NotFound");
    }
}
