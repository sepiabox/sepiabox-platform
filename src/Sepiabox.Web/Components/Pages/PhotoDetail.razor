@page "/photos/{Id}"
@using Sepiabox.Catalog.Search
@inject ILibraryQueries Library
@inject NavigationManager Navigation
@* Static server rendering (no @rendermode): the page is plain HTML with links, nothing interactive. *@

@if (_asset is not null)
{
    <PageTitle>@Title · Sepiabox</PageTitle>

    <p class="back"><a href="@BackLink">@Text["Detail_Back"]</a></p>

    <div class="detail">
        <figure class="preview">
            @if (AssetKinds.IsVideo(_asset.Kind))
            {
                <VideoPlayer AssetId="@_asset.Id" Label="@VideoLabel" PosterName="@_asset.PreviewName" HasProxy="_asset.HasProxy" />
            }
            else if (_asset.PreviewName is { } preview)
            {
                <img src="photos/@_asset.Id/@preview" alt="@Text.KindLabel(_asset.Kind)" />
            }
            else
            {
                <span class="placeholder">@Text["Detail_NoPreview"]</span>
            }
        </figure>

        <section class="facts">
            <h1>@Title</h1>
            <dl>
                @if (_asset.Place is { } place)
                {
                    <dt>@Text["Detail_Place"]</dt>
                    <dd>@place</dd>
                }
                @if (Camera is { } camera)
                {
                    <dt>@Text["Detail_Camera"]</dt>
                    <dd>@camera</dd>
                }
                @if (_asset.Width is { } width && _asset.Height is { } height)
                {
                    <dt>@Text["Detail_Dimensions"]</dt>
                    <dd class="mono">@width × @height</dd>
                }
                @if (AssetKinds.IsVideo(_asset.Kind) && VideoDurations.Format(_asset.DurationSeconds) is { } duration)
                {
                    <dt>@Text["Detail_Duration"]</dt>
                    <dd class="mono">@duration</dd>
                }
                <dt>@Text["Detail_Type"]</dt>
                <dd>@Text.KindLabel(_asset.Kind)</dd>
            </dl>

            @if (_asset.Location is not null)
            {
                @* Opens the places page with this photo's coordinates filled in (S-014). *@
                <p class="save-place"><a href="places?asset=@_asset.Id">@Text["Detail_SavePlace"]</a></p>
            }

            @if (_asset.People.Count > 0)
            {
                @* A named person links to their photos; an unnamed one to their page, to be named (S-021). *@
                <h2>@Text["Detail_People"]</h2>
                <ul class="photo-people">
                    @foreach (var person in _asset.People)
                    {
                        <li>
                            @if (person.Name is { } name)
                            {
                                <a href="@SearchLinks.Timeline(new SearchQuery { Filters = new SearchFilters { People = new PeopleFilter { All = [name] } } })">@name</a>
                            }
                            else
                            {
                                <a href="people/@person.Id">@Text["People_Unnamed"]</a>
                            }
                        </li>
                    }
                </ul>
            }

            <h2>@Text["Detail_Sources"]</h2>
            <ul class="sources">
                @foreach (var source in _asset.Sources)
                {
                    <li><span class="source-name">@source.Name</span> <span class="mono">@source.Path</span></li>
                }
            </ul>

            @* Not an enhanced navigation: Blazor would fetch the redirect itself, fail on CORS and read the original twice.
               No `download` attribute: Content-Disposition names the file, and a failure message must stay visible. *@
            <p><a class="button" href="photos/@_asset.Id/original" data-enhance-nav="false">@Text["Detail_DownloadOriginal"]</a></p>
        </section>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    /// <summary>The timeline page the visitor came from, so "back" returns there.</summary>
    [SupplyParameterFromQuery(Name = "page")]
    public string? PageQuery { get; set; }

    private AssetDetail? _asset;

    protected override async Task OnParametersSetAsync()
    {
        var asset = AssetIds.IsValid(Id) ? await Library.GetAssetAsync(Id) : null;
        _asset = asset;
        if (asset is null)
        {
            Navigation.NotFound();
        }
    }

    private string Title => Text.DateOrNoDate(_asset?.CapturedAt);

    private string VideoLabel => _asset?.CapturedAt is { } at ? Text["Detail_VideoFrom", Text.DateAndTime(at)] : Text["Detail_UndatedVideo"];

    /// <summary>The filters the visitor came from (S-013), so "back" returns to them.</summary>
    [SupplyParameterFromQuery(Name = SearchLinks.QueryParameter)]
    public string? SearchQueryParameter { get; set; }

    // Only a query that decodes is linked back, so the link never carries anything else from the URL.
    private string BackLink =>
        Sepiabox.Catalog.Search.SearchQueryJson.TryDecode(SearchQueryParameter, out var query, out _) ? SearchLinks.Timeline(query)
        : LibraryQueries.ParsePage(PageQuery) is > 1 and var page ? $"./?page={page}"
        : "./";

    private string? Camera =>
        string.Join(' ', new[] { _asset?.CameraMake, _asset?.CameraModel }.Where(s => !string.IsNullOrWhiteSpace(s))) is { Length: > 0 } text
            ? text
            : null;
}
