@page "/photos/{Id}"
@using Sepiabox.Catalog.Search
@inject ILibraryQueries Library
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject ILogger<PhotoDetail> Log
@* Static server rendering (no @rendermode): the page is plain HTML with links, nothing interactive. *@

@if (_asset is not null)
{
    <PageTitle>@Title · Sepiabox</PageTitle>

    <p class="back"><a href="@BackLink">@Text["Detail_Back"]</a></p>

    @if (Note == "ignored")
    {
        <p class="note" role="status">@Text["Detail_Done_Ignored"]</p>
    }

    <div class="detail">
        <figure class="preview stage">
            @if (AssetKinds.IsVideo(_asset.Kind))
            {
                <VideoPlayer AssetId="@_asset.Id" Label="@VideoLabel" PosterName="@_asset.PreviewName" HasProxy="_asset.HasProxy" ProxyName="@_asset.ProxyName" />
            }
            else if (_asset.PreviewName is { } preview)
            {
                @if (_regionSearch)
                {
                    @* "Photos like this part" (S-041): wwwroot/region.js shows the button and the form; without it, the page is as ever. *@
                    <div class="region" data-region>
                        <div class="region-frame" data-region-frame role="group" aria-label="@Text["Region_FrameLabel"]" aria-describedby="region-hint">
                            <img src="photos/@_asset.Id/@preview" alt="@Text.KindLabel(_asset.Kind)" />
                            <div class="region-box" data-region-box hidden></div>
                        </div>
                        <div class="region-tools">
                            <button type="button" class="button" data-region-toggle aria-pressed="false" hidden>@Text["Region_Select"]</button>
                            <form method="get" action="./" data-region-form hidden>
                                <input type="hidden" name="filter" value="1" />
                                <input type="hidden" name="@SearchLinks.RegionAssetParameter" value="@_asset.Id" />
                                <input type="hidden" name="@SearchLinks.RegionBoxParameter" value="" data-region-input />
                                <p id="region-hint" class="muted">@Text["Region_Hint"]</p>
                                <p class="region-status muted" data-region-status data-selected="@Text["Region_StatusSelected"]" data-none="@Text["Region_StatusNone"]" role="status"></p>
                                <button type="submit" class="button" data-region-submit disabled>@Text["Region_Find"]</button>
                                <button type="button" class="button" data-region-clear hidden>@Text["Region_Clear"]</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <img src="photos/@_asset.Id/@preview" alt="@Text.KindLabel(_asset.Kind)" />
                }
            }
            else
            {
                <span class="placeholder">@Text["Detail_NoPreview"]</span>
            }
            @* Previous and next in the order of the listing the visitor came from (S-068): plain links, so the keyboard reaches them. *@
            @if (_previous is not null)
            {
                <a class="nav-arrow prev" href="@NeighbourLink(_previous)" aria-label="@Text["Detail_Previous"]" rel="prev">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 5-7 7 7 7" /></svg>
                </a>
            }
            @if (_next is not null)
            {
                <a class="nav-arrow next" href="@NeighbourLink(_next)" aria-label="@Text["Detail_Next"]" rel="next">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7" /></svg>
                </a>
            }
        </figure>

        <aside class="side" aria-label="@Text["Detail_Panel"]">
        <section class="card facts">
            <p class="eyebrow">@Text.KindLabel(_asset.Kind)</p>
            <h1>@Title</h1>
            <dl>
                @if (_asset.Place is { } place)
                {
                    <dt>@Text["Detail_Place"]</dt>
                    <dd>@place</dd>
                }
                @if (Camera is { } camera)
                {
                    <dt>@Text["Detail_Camera"]</dt>
                    <dd>@camera</dd>
                }
                @if (_asset.Width is { } width && _asset.Height is { } height)
                {
                    <dt>@Text["Detail_Dimensions"]</dt>
                    <dd class="mono">@width × @height</dd>
                }
                @if (AssetKinds.IsVideo(_asset.Kind) && VideoDurations.Format(_asset.DurationSeconds) is { } duration)
                {
                    <dt>@Text["Detail_Duration"]</dt>
                    <dd class="mono">@duration</dd>
                }
                <dt>@Text["Detail_Type"]</dt>
                <dd>@Text.KindLabel(_asset.Kind)</dd>
                @if (_asset.CapturedAtSource == "export")
                {
                    @* An export's date is not the camera's (S-045): say so, without saying more than the manifest does. *@
                    <dt>@Text["Detail_DateSource"]</dt>
                    <dd>@Text["Detail_DateFromExport"]</dd>
                }
                @if (_asset.Caption is { } caption)
                {
                    @* As the family or the export wrote it (S-052): text, never markup, with its line breaks kept, across the whole width. *@
                    <dt class="caption-label">@Text["Detail_Caption"]</dt>
                    <dd class="caption">@caption</dd>
                }
            </dl>

            @if (_asset.Location is not null)
            {
                @* Opens the places page with this photo's coordinates filled in (S-014). *@
                <p class="save-place"><a href="places?asset=@_asset.Id">@Text["Detail_SavePlace"]</a></p>
            }

            @* "More photos similar to this one" (S-017) compares the photo's own embedding: until it has one, say so. *@
            @if (_asset.HasEmbedding)
            {
                <p class="similar actions"><a class="button secondary" href="@SearchLinks.Timeline(SearchLinks.Similar(_asset.Id))">@Text["Detail_Similar"]</a></p>
            }
            else
            {
                <p class="similar muted" role="status">@SimilarSearch.NotAnalysed(_asset.Kind, Text)</p>
            }

            @* Not an enhanced navigation: Blazor would fetch the redirect itself, fail on CORS and read the original twice.
               No `download` attribute: Content-Disposition names the file, and a failure message must stay visible. *@
            @if (_asset.OriginalStored)
            {
                <p class="actions"><a class="button" href="photos/@_asset.Id/original" data-enhance-nav="false">@Text["Detail_DownloadOriginal"]</a></p>
            }
            else
            {
                @* Where the button would be: say why there is none (S-064). *@
                <p class="muted kept-at-source">@Text["Download_KeptAtSource"]</p>
            }
        </section>

        @if (_asset.Faces.Count > 0)
        {
            @* One thumbnail for each counted face (S-068): a named person's links to their photos, an unnamed one's to their page, to be named (S-021). *@
            <section class="card people-card">
                <h2>@Text["Detail_People"]</h2>
                <div class="faces">
                    @{ var unnamedNumber = 0; }
                    @foreach (var face in _asset.Faces)
                    {
                        @* Unnamed faces are all "Add a name": the accessible name says which one, in display order, the visible text first. *@
                        <a class="face@(face.Name is null ? " unnamed" : " named")" href="@FaceHref(face)" aria-label="@(face.Name is null ? Text["Detail_AddNameFace", ++unnamedNumber].Value : null)">
                            <PersonAvatar Name="@face.Name" PersonId="@face.PersonId" Size="md" Crop="@face.Crop" />
                            <span class="name">@(face.Name ?? Text["Detail_AddName"])</span>
                        </a>
                    }
                </div>
            </section>
        }

        @if (_asset.People.Any(p => p.Name is null && p.FaceId != 0))
        {
            @* Opens a confirmation; a stranger's face (a poster, a crowd) is deleted for good there (#107): one link for each unnamed person, with their first face. *@
            var strangerNumber = 0;
            <section class="card ignore-card">
            <ul class="ignore-faces-list">
                @foreach (var person in _asset.People.Where(p => p.Name is null && p.FaceId != 0))
                {
                    <li><a href="photos/@_asset.Id/ignore-faces?face=@person.FaceId" class="small ignore-face" data-enhance-nav="false" aria-label="@Text["Detail_IgnoreFace_Named", ++strangerNumber]">@Text["Detail_IgnoreFace"]</a></li>
                }
            </ul>
            @if (_asset.People.Count(p => p.Name is null && p.FaceId != 0) > 1)
            {
                <p class="ignore-faces"><a href="photos/@_asset.Id/ignore-faces" data-enhance-nav="false">@Text["Detail_IgnoreUnnamed"]</a></p>
            }
            </section>
        }

            @if (_asset.Albums.Count > 0)
            {
                @* Each album links to the photos in it (S-052). *@
                <section class="card albums-card"><h2>@Text["Detail_Albums"]</h2>
                <ul class="photo-albums">
                    @foreach (var album in _asset.Albums.Take(VisibleAlbums))
                    {
                        <li><a class="pill" href="@SearchLinks.Timeline(new SearchQuery { Filters = new SearchFilters { Albums = [album] } })">@album</a></li>
                    }
                </ul>
                @if (_asset.Albums.Count > VisibleAlbums)
                {
                    @* Thirty albums would push the rest of the page far down: the first few, then the others folded away. *@
                    <details class="more-albums">
                        <summary>@Text[_asset.Albums.Count - VisibleAlbums == 1 ? "Detail_MoreAlbums_One" : "Detail_MoreAlbums_Other", _asset.Albums.Count - VisibleAlbums]</summary>
                        <ul class="photo-albums">
                            @foreach (var album in _asset.Albums.Skip(VisibleAlbums))
                            {
                                <li><a class="pill" href="@SearchLinks.Timeline(new SearchQuery { Filters = new SearchFilters { Albums = [album] } })">@album</a></li>
                            }
                        </ul>
                    </details>
                }
                </section>
            }

        <section class="card source-card">
            <h2>@Text["Detail_Sources"]</h2>
            <ul class="sources">
                @foreach (var source in _asset.Sources)
                {
                    var link = SourceLinks.SafeUrl(source.Url);
                    var line = link is null && !_asset.OriginalStored ? SourceLinks.StoredLine(source, Text) : null;
                    <li class="src">
                        @if (line is not null)
                        {
                            @* An original Sepiabox does not keep, with no address: say where it is (S-064). *@
                            <span class="source-line">@line.Text@if (line.Path is { } path){@(" ")<span class="mono path" title="@path">@path</span>}</span>
                        }
                        else
                        {
                            <strong class="source-name">@source.Name</strong>
                            <span class="mono path" title="@source.Path">@source.Path</span>
                            @if (source.Path.Length > LongPath)
                            {
                                @* The path is cut short in the card; the whole of it is a click away, with no script. *@
                                <details class="full-path">
                                    <summary>@Text["Detail_ShowFullPath"]</summary>
                                    <span class="mono path-full">@source.Path</span>
                                </details>
                            }
                        }
                        @if (SourceLinks.OriginalHref(_asset.Id, source, _asset.OriginalStored) is { } openOriginal)
                        {
                            @* The file is fetched from the Drive by the server (S-038): not a link to Google, and not kept. *@
                            <a class="source-link" href="@openOriginal" data-enhance-nav="false">@Text["Source_OpenOriginal"]</a>
                            <span class="muted small original-hint">@Text["Source_OpenOriginalHint"]</span>
                        }
                        @if (source.Removed)
                        {
                            <span class="source-removed muted">@Text["Source_Removed"]</span>
                        }
                        @if (link is not null)
                        {
                            @* The address is untrusted text: only https is ever a link, in a new tab that gets nothing from this page. *@
                            <a class="source-link" href="@link" target="_blank" rel="noopener noreferrer">@SourceLinks.LinkText(source, Text)<span class="visually-hidden">@(" " + Text["Source_NewTab"].Value)</span></a>
                        }
                    </li>
                }
            </ul>
        </section>
        </aside>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    /// <summary>The timeline page the visitor came from, so "back" returns there.</summary>
    [SupplyParameterFromQuery(Name = "page")]
    public string? PageQuery { get; set; }

    // Only "ignored" is shown; nothing else from the address.
    [SupplyParameterFromQuery(Name = "note")]
    public string? Note { get; set; }

    private const int VisibleAlbums = 5;

    // A path longer than this is cut short in the card and offered whole under "Show full path" (S-068).
    private const int LongPath = 36;

    private TimelineItem? _previous;
    private TimelineItem? _next;

    private AssetDetail? _asset;

    // Without the image model nothing is offered, as the description box is hidden without the text model (S-016).
    private bool _regionSearch;

    protected override async Task OnParametersSetAsync()
    {
        var asset = AssetIds.IsValid(Id) ? await Library.GetAssetAsync(Id) : null;
        _asset = asset;
        _regionSearch = asset is not null && !AssetKinds.IsVideo(asset.Kind)
            && Services.GetService<Sepiabox.Catalog.Search.IRegionEmbedder>() is { IsAvailable: true };
        if (asset is null)
        {
            Navigation.NotFound();
            return;
        }

        try
        {
            await FindNeighboursAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // The arrows are a convenience: a failing listing must not take the photo with it.
            (_previous, _next) = (null, null);
            Log.LogWarning(ex, "The photos before and after {AssetId} could not be found; the page has no arrows.", Id);
        }
    }

    // The photo before and after this one in the listing the visitor came from: the filtered search or the timeline page, both newest first.
    // A ranking (similar photos, a region) has no such order, so it has no arrows; neither has a photo at the edge of its page.
    private async Task FindNeighboursAsync()
    {
        (_previous, _next) = (null, null);
        IReadOnlyList<TimelineItem>? listing = null;
        if (SearchQueryParameter is not null)
        {
            if (SearchQueryJson.TryDecode(SearchQueryParameter, out var query, out _)
                && query.Filters.SimilarTo is null && query.Filters.SimilarToRegion is null && query.Filters.Visual is null)
            {
                listing = (await Library.SearchAsync(query)).Items;
            }
        }
        else if (PageQuery is not null)
        {
            // Only a visitor who came from a listing has an order to move in: one who came from a person's or an occasion's page,
            // or by an address typed or shared, has no page in it, and the timeline's first page would be the wrong context.
            listing = (await Library.GetTimelinePageAsync(LibraryQueries.ParsePage(PageQuery))).Items;
        }

        if (listing is null)
        {
            return;
        }

        var index = -1;
        for (var i = 0; i < listing.Count; i++)
        {
            if (listing[i].Id == Id)
            {
                index = i;
                break;
            }
        }

        if (index >= 0)
        {
            _previous = index > 0 ? listing[index - 1] : null;
            _next = index < listing.Count - 1 ? listing[index + 1] : null;
        }
    }

    // The same query or page as this one, so the arrows keep the way back and the order.
    private string NeighbourLink(TimelineItem item) =>
        SearchQueryParameter is not null ? $"photos/{item.Id}?{SearchLinks.QueryParameter}={Uri.EscapeDataString(SearchQueryParameter)}"
        : $"photos/{item.Id}?page={LibraryQueries.ParsePage(PageQuery)}";

    // A named person's face goes to their photos; an unnamed one's to their page, to be named (S-021).
    private static string FaceHref(AssetFace face) =>
        face.Name is { } name
            ? SearchLinks.Timeline(new SearchQuery { Filters = new SearchFilters { People = new PeopleFilter { All = [name] } } })
            : $"people/{face.PersonId}";

    private string Title => Text.DateOrNoDate(_asset?.CapturedAt);

    private string VideoLabel => _asset?.CapturedAt is { } at ? Text["Detail_VideoFrom", Text.DateAndTime(at)] : Text["Detail_UndatedVideo"];

    /// <summary>The filters the visitor came from (S-013), so "back" returns to them.</summary>
    [SupplyParameterFromQuery(Name = SearchLinks.QueryParameter)]
    public string? SearchQueryParameter { get; set; }

    // Only a query that decodes is linked back, so the link never carries anything else from the URL.
    private string BackLink =>
        Sepiabox.Catalog.Search.SearchQueryJson.TryDecode(SearchQueryParameter, out var query, out _) ? SearchLinks.Timeline(query)
        : LibraryQueries.ParsePage(PageQuery) is > 1 and var page ? $"./?page={page}"
        : "./";

    private string? Camera =>
        string.Join(' ', new[] { _asset?.CameraMake, _asset?.CameraModel }.Where(s => !string.IsNullOrWhiteSpace(s))) is { Length: > 0 } text
            ? text
            : null;
}
