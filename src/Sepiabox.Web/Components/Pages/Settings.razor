@page "/settings"
@inject IFaceSettings Faces
@inject NavigationManager Navigation
@inject IServiceProvider Services
@using Sepiabox.Catalog
@using Sepiabox.Catalog.Search
@using Microsoft.Extensions.DependencyInjection
@* Static server rendering with POST forms, as the person page (S-020): turning face recognition off asks first, on this
   page itself (S-022, D-081), and every change is answered with a redirect back here with a note. *@

<PageTitle>@Text["Settings_Heading"] · Sepiabox</PageTitle>

<PageHead Title="@Text["Settings_Heading"]" />

@if (NoteText is { } note)
{
    <Notice>@note</Notice>
}

<div class="settings-layout">
    <nav class="settings-nav" aria-label="@Text["Settings_Nav_Label"]">
        <a href="settings#settings-faces-heading">@Text["Settings_Faces_Heading"]</a>
        <a href="settings#settings-export-heading">@Text["Export_Heading"]</a>
        @if (_view is { State.On: true })
        {
            <a href="settings#settings-danger-heading" class="danger-link">@Text["Settings_Danger_Heading"]</a>
        }
    </nav>

    <div class="settings-sections form-col">
        @if (_view is { } view)
        {
            <Panel Class="settings-faces" HeadingId="settings-faces-heading" Title="@Text["Settings_Faces_Heading"]">
                @if (view.State.On)
                {
                    <p class="faces-status">@Text["Settings_Faces_IsOn"]</p>
                }
                else
                {
                    <p class="faces-status">@Text["Settings_Faces_IsOff"]</p>
                    @if (view.State.ManifestsPending)
                    {
                        <p class="faces-sweep muted">@Text["Settings_Faces_Pending"]</p>
                    }
                    else
                    {
                        <p class="faces-sweep muted">@Text["Settings_Faces_Swept"]</p>
                        <form method="post" @formname="on" @onsubmit="TurnOnAsync" class="turn-on">
                            <AntiforgeryToken />
                            <input type="hidden" name="On" value="yes" />
                            <div class="form-actions"><button type="submit" class="button">@Text["Settings_Faces_On"]</button></div>
                        </form>
                    }
                }

                <p class="hint muted work-folder">@Text["Settings_Faces_WorkFolder"]</p>
                <p class="hint muted backups">@Text["Settings_Faces_Backups"]</p>

                @if (view.History.Count > 0)
                {
                    <h3>@Text["Settings_Faces_History"]</h3>
                    <div class="table-wrap">
                        <table class="face-deletions">
                            <thead>
                                <tr>
                                    <th scope="col">@Text["Settings_Faces_History_When"]</th>
                                    <th scope="col">@Text["Settings_Faces_History_Who"]</th>
                                    <th scope="col">@Text["Settings_Faces_History_What"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var deletion in view.History)
                                {
                                    <tr>
                                        <td class="when">@When(deletion)</td>
                                        <td class="who">@deletion.DeletedBy</td>
                                        <td class="what">@What(deletion)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </Panel>
        }

        <Panel Class="settings-export" HeadingId="settings-export-heading" Title="@Text["Export_Heading"]">
            <p class="muted">@Text["Export_Intro"]</p>
            <p><a class="button" href="settings/export">@Text["Settings_Export_Link"]</a></p>
        </Panel>

        @if (_view is { State.On: true })
        {
            <Panel Class="danger-zone" HeadingId="settings-danger-heading" Title="@Text["Settings_Danger_Heading"]">
                <p class="muted">@Text["Settings_Danger_Intro"]</p>
                @if (Confirm == ConfirmOff)
                {
                    <div class="confirm-off">
                        <Notice Variant="@NoticeVariant.Warning" Class="confirm-explain">@Text["Settings_Faces_OffExplain"]</Notice>
                        <form method="post" @formname="off" @onsubmit="TurnOffAsync" class="confirm">
                            <AntiforgeryToken />
                            <input type="hidden" name="Off" value="yes" />
                            <div class="form-actions">
                                <button type="submit" class="button danger">@Text["Settings_Faces_OffConfirm"]</button>
                                <a href="settings">@Text["Settings_Cancel"]</a>
                            </div>
                        </form>
                    </div>
                }
                else
                {
                    <p class="hint muted">@Text["Settings_Faces_OffHint"]</p>
                    @* A GET form: it only opens the confirmation above, which turns recognition off on its own POST. *@
                    <form method="get" action="settings" class="ask-off">
                        <input type="hidden" name="confirm" value="@ConfirmOff" />
                        <div class="form-actions"><button type="submit" class="button danger">@Text["Settings_Faces_Off"]</button></div>
                    </form>
                }
            </Panel>
        }
    </div>
</div>

@code {
    private const string ConfirmOff = "faces-off";

    // What a note in the address may say, and its text: nothing else from the address is shown.
    private static readonly Dictionary<string, string> s_notes = new(StringComparer.Ordinal)
    {
        ["faces-off"] = "Settings_Done_Off",
        ["faces-on"] = "Settings_Done_On",
        ["faces-pending"] = "Settings_Error_Pending",
        ["signed-out"] = "Settings_Error_NoEmail",
    };

    [SupplyParameterFromQuery(Name = "confirm")]
    public string? Confirm { get; set; }

    [SupplyParameterFromQuery(Name = PersonLinks.NoteParameter)]
    public string? Note { get; set; }

    [SupplyParameterFromForm(FormName = "off")]
    public string? Off { get; set; }

    [SupplyParameterFromForm(FormName = "on")]
    public string? On { get; set; }

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private FaceSettingsView? _view;

    private string? Email => HttpContext?.User.FindFirst(ClaimTypes.Email)?.Value;

    private string? NoteText => Note is not null && s_notes.TryGetValue(Note, out var key) ? Text[key].Value : null;

    protected override async Task OnInitializedAsync() => _view = await Faces.GetAsync();

    private async Task TurnOffAsync()
    {
        if (Email is not { } email)
        {
            Navigation.NavigateTo($"settings?{PersonLinks.NoteParameter}=signed-out");
            return;
        }

        await Faces.TurnOffAsync(email);
        Navigation.NavigateTo($"settings?{PersonLinks.NoteParameter}=faces-off");
    }

    private async Task TurnOnAsync() =>
        Navigation.NavigateTo($"settings?{PersonLinks.NoteParameter}={(await Faces.TurnOnAsync() ? "faces-on" : "faces-pending")}");

    // In the library's time zone (Search:TimeZone), as "today" is for questions.
    private string When(FaceDataDeletion deletion)
    {
        var zone = Services.GetService<SearchOptions>()?.TimeZone ?? TimeZoneInfo.Utc;
        return TimeZoneInfo.ConvertTime(deletion.DeletedAt, zone).ToString("g", System.Globalization.CultureInfo.CurrentCulture);
    }

    private string What(FaceDataDeletion deletion) =>
        deletion.Scope == FaceDataDeletionScopes.Library
            ? Text["Settings_Faces_History_WhatLibrary", deletion.Faces, deletion.People].Value
            : Text["Settings_Faces_History_WhatPerson", deletion.Faces].Value;
}
