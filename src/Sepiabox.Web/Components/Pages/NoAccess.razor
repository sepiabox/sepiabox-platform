@page "/no-access"
@attribute [AllowAnonymous]
@* Static server rendering, like the sign-in page. *@

<PageTitle>@Text["NoAccess_Title"] · Sepiabox</PageTitle>

<AuthCard>
    <h1>@Text["NoAccess_Title"]</h1>
    <p>@Text["NoAccess_Text"]</p>

    <div class="providers">
        @if (_signedIn)
        {
            <SignOutButton Label="@Text["NoAccess_SignOutAndSwitch"]" />
        }
        else
        {
            <a class="button" href="sign-in">@Text["NoAccess_SwitchAccount"]</a>
        }
    </div>
</AuthCard>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool _signedIn;

    protected override async Task OnInitializedAsync() =>
        _signedIn = AuthenticationState is not null && (await AuthenticationState).User.Identity?.IsAuthenticated == true;
}
