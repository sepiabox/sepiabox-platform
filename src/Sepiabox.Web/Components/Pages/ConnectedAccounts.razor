@page "/sources"
@using System.Globalization
@using Sepiabox.Catalog
@using Sepiabox.Web.Sources
@inject IConnectedSources Connections
@inject NavigationManager Navigation
@* Static server rendering with POST forms, as the places page (S-014): an action is answered with a redirect back here
   and a note, so reloading never repeats it. Connecting goes through Google and back (SourceEndpoints). *@

<PageTitle>@Text["Sources_Heading"] · Sepiabox</PageTitle>

<PageHead Title="@Text["Sources_Heading"]">
    <Subtitle>@Text["Sources_Intro"]</Subtitle>
</PageHead>

@if (NoteText is { } note)
{
    <Notice Variant="@NoteVariant">@note</Notice>
}

@* One card for each connected account (S-076): the service's icon, the account with its status, the counts and when they were made,
   and the actions on the right with what disconnecting does beside them. A service with no account has a card of its own with one
   button. The 7-day expiry is said only for an account whose access has expired. *@
@if (_sources is null)
{
    <p class="muted">@Text["Timeline_Loading"]</p>
}
else
{
    @if (_sources.Count > 0)
    {
        <ul class="connections">
            @foreach (var source in _sources)
            {
                <li class="connection">
                    <svg class="service-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 4h7l5.5 9.5-3.5 6h-11L3 13.5z" /><path d="M8.5 4L14 13.5M15.5 4L10 13.5M3 13.5h11M10 13.5l3.5 6" /></svg>
                    <div class="connection-body">
                        <p class="connection-account"><strong>@source.AccountEmail</strong>
                            <span class="status @(source.NeedsReconnecting ? "status-expired" : "status-ok")">@Text["Sources_Status_" + source.Status]</span></p>
                        <p class="muted small connection-service-name">@Text["Sources_GoogleDrive"]</p>

                        @if (source.NeedsReconnecting)
                        {
                            <p class="muted">@Text["Sources_ExpiredHint"]</p>
                        }

                        @if (source is { PhotoCount: { } photos, VideoCount: { } videos })
                        {
                            <p class="counts">
                                <span class="photos">@Text["Sources_Photos", photos.ToString("N0", CultureInfo.CurrentCulture)]</span>
                                <span class="videos">@Text["Sources_Videos", videos.ToString("N0", CultureInfo.CurrentCulture)]</span>
                                @if (source.CountedAt is { } counted)
                                {
                                    <span class="muted small">@Text["Sources_CountedAt", Text.DateAndTime(counted.UtcDateTime)]</span>
                                }
                            </p>
                        }
                        else
                        {
                            <p class="muted">@Text["Sources_NotCounted"]</p>
                        }
                    </div>

                    <div class="connection-side">
                        <div class="connection-actions">
                            @if (source.NeedsReconnecting)
                            {
                                <a class="button" href="@SourceEndpoints.ConnectPath.TrimStart('/')" aria-label="@Text["Sources_ReconnectAria", source.AccountEmail]">@Text["Sources_Reconnect"]</a>
                            }
                            else
                            {
                                <form method="post" @formname="@("count-" + source.Id.ToString(CultureInfo.InvariantCulture))" @onsubmit="CountAsync">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="SourceId" value="@source.Id.ToString(CultureInfo.InvariantCulture)" />
                                    <button type="submit" class="button secondary" aria-label="@Text["Sources_CountAria", source.AccountEmail]">@Text["Sources_Count"]</button>
                                </form>
                            }

                            <form method="post" @formname="@("disconnect-" + source.Id.ToString(CultureInfo.InvariantCulture))" @onsubmit="DisconnectAsync">
                                <AntiforgeryToken />
                                <input type="hidden" name="SourceId" value="@source.Id.ToString(CultureInfo.InvariantCulture)" />
                                <button type="submit" class="button danger" aria-label="@Text["Sources_DisconnectAria", source.AccountEmail]">@Text["Sources_Disconnect"]</button>
                            </form>
                        </div>
                        <p class="muted small disconnect-hint">@Text["Sources_DisconnectHint"]</p>
                    </div>
                </li>
            }
        </ul>
    }

    @if (Connections.CanConnectGoogleDrive)
    {
        @if (_sources.Count == 0)
        {
            @* The service is not connected: its own card with the one thing to do. *@
            <section class="panel service-card not-connected" aria-labelledby="service-google-drive">
                <svg class="service-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 4h7l5.5 9.5-3.5 6h-11L3 13.5z" /><path d="M8.5 4L14 13.5M15.5 4L10 13.5M3 13.5h11M10 13.5l3.5 6" /></svg>
                <div class="connection-body">
                    <h2 id="service-google-drive">@Text["Sources_GoogleDrive"]</h2>
                    <p class="muted">@Text["Sources_None"]</p>
                </div>
                <div class="connection-side"><a class="button connect" href="@SourceEndpoints.ConnectPath.TrimStart('/')">@Text["Sources_Connect"]</a></div>
            </section>
        }
        else
        {
            <p class="connect-more"><a class="button connect secondary" href="@SourceEndpoints.ConnectPath.TrimStart('/')">@Text["Sources_Connect"]</a></p>
        }
    }
    else
    {
        <Notice Variant="@NoticeVariant.Warning">@Text["Sources_NotConfigured"]</Notice>
    }
}

@code {
    // What a note in the address may say, and its text: nothing else from the address is shown.
    private static readonly Dictionary<string, (string Key, string Variant)> s_notes = new(StringComparer.Ordinal)
    {
        ["connected"] = ("Sources_Note_connected", NoticeVariant.Success),
        ["denied"] = ("Sources_Note_denied", NoticeVariant.Error),
        ["state"] = ("Sources_Note_state", NoticeVariant.Error),
        ["failed"] = ("Sources_Note_failed", NoticeVariant.Error),
        ["not-configured"] = ("Sources_NotConfigured", NoticeVariant.Error),
        ["counted"] = ("Sources_Note_counted", NoticeVariant.Success),
        ["disconnected"] = ("Sources_Note_disconnected", NoticeVariant.Success),
        ["reconnect"] = ("Sources_Note_reconnect", NoticeVariant.Warning),
        ["count-failed"] = ("Sources_Note_countFailed", NoticeVariant.Error),
        ["not-found"] = ("Sources_Note_notFound", NoticeVariant.Error),
    };

    [SupplyParameterFromQuery(Name = SourceEndpoints.NoteParameter)]
    public string? Note { get; set; }

    /// <summary>The connection whose form was sent (each has its own form name).</summary>
    [SupplyParameterFromForm]
    public string? SourceId { get; set; }

    private IReadOnlyList<ConnectedSourceSummary>? _sources;

    private string? NoteText => Note is not null && s_notes.TryGetValue(Note, out var known) ? Text[known.Key].Value : null;

    private string NoteVariant => Note is not null && s_notes.TryGetValue(Note, out var known) ? known.Variant : NoticeVariant.Success;

    protected override async Task OnInitializedAsync() => _sources = await Connections.ListAsync();

    private async Task CountAsync()
    {
        var outcome = TryId(out var id) ? await Connections.CountAsync(id) : SourceOutcome.NotFound;
        Back(outcome switch
        {
            SourceOutcome.Done => "counted",
            SourceOutcome.Reconnect => "reconnect",
            SourceOutcome.Failed => "count-failed",
            _ => "not-found",
        });
    }

    private async Task DisconnectAsync()
    {
        var outcome = TryId(out var id) ? await Connections.DisconnectAsync(id) : SourceOutcome.NotFound;
        Back(outcome == SourceOutcome.Done ? "disconnected" : "not-found");
    }

    private bool TryId(out long id) => long.TryParse(SourceId, NumberStyles.None, CultureInfo.InvariantCulture, out id);

    private void Back(string note) => Navigation.NavigateTo($"sources?{SourceEndpoints.NoteParameter}={note}");
}
