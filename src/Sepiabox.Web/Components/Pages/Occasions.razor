@page "/occasions"
@using Microsoft.AspNetCore.WebUtilities
@using Sepiabox.Catalog.Events
@using Sepiabox.Web.Components.Occasions
@inject ILibraryQueries Library
@inject NavigationManager Navigation
@* Static server rendering, as the timeline: the occasions photos were grouped into (S-023), newest first, with a GET
   form to show one type of them (S-024). *@

<PageTitle>@Text["Occasions_Heading"] · Sepiabox</PageTitle>

<PageHead Title="@Text["Occasions_Heading"]" />

@if (_types.Count > 0 || _type is not null)
{
    @* The timeline's chip control (S-067): the type as radios in a dropdown, with how many occasions each has; "Filter" applies without JavaScript. *@
    <form class="filters occasion-filter" method="get" action="occasions" role="search" aria-label="@Text["Occasions_FilterLabel"]">
        <div class="chips">
            <FilterChip Label="@Text["Occasions_FilterType"]" Set="@(_type is not null)" Value="@(_type is null ? null : Text.EventTypeLabel(_type))">
                <FilterRadios Name="type" Selected="@_type" Options="@_types.Select(t => (t, TypeOption(t)))" />
            </FilterChip>
        </div>
        <button type="submit" class="button">@Text["Filter_Apply"]</button>
        @if (_type is not null)
        {
            <a class="clear" href="occasions">@Text["Filter_Clear"]</a>
        }
    </form>
}

@if (_page is null)
{
    <p class="muted">@Text["Timeline_Loading"]</p>
}
else if (_page.Items.Count == 0 && _page.Page == 1 && _type is not null)
{
    <EmptyState Title="@Text["Occasions_NoneOfType"]">
        <Action><a class="button secondary" href="occasions">@Text["Occasions_ShowAll"]</a></Action>
    </EmptyState>
}
else if (_page.Items.Count == 0 && _page.Page == 1)
{
    <EmptyState Title="@Text["Occasions_None"]">@Text["Occasions_NoneHelp"]</EmptyState>
}
else if (_page.Items.Count == 0)
{
    <p class="empty">@Text["Occasions_NoMore"] <a href="@PageLink(1)">@Text["Timeline_BackToStart"]</a></p>
}
else
{
    @foreach (var year in _page.Items.GroupBy(o => o.StartsAt.Year))
    {
        @* A heading for each year with how many occasions it has (all pages, the same filter), the cards on a surface under it (S-075). *@
        <SectionTitle Title="@year.Key.ToString(System.Globalization.CultureInfo.CurrentCulture)" Count="@(_page.YearCounts.TryGetValue(year.Key, out var total) ? total : year.Count())" />
        <ul class="occasions">
            @foreach (var occasion in year)
            {
                <li class="occasion"><OccasionCard Occasion="occasion" /></li>
            }
        </ul>
    }

    <nav class="pages" aria-label="@Text["Timeline_Pages"]">
        @if (_page.Page > 1)
        {
            <a href="@PageLink(_page.Page - 1)">@Text["Timeline_Newer"]</a>
        }
        @if (_page.HasMore)
        {
            <a href="@PageLink(_page.Page + 1)">@Text["Timeline_Older"]</a>
        }
    </nav>
}

@code {
    // Text, not int: a hand-typed "abc" must become a page, not a binding error.
    [SupplyParameterFromQuery(Name = "page")]
    public string? PageQuery { get; set; }

    /// <summary>One of the occasion types; anything else in the address is no filter.</summary>
    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeQuery { get; set; }

    private OccasionsPage? _page;
    private IReadOnlyList<string> _types = [];
    private string? _type;
    private IReadOnlyDictionary<string, int> _counts = new Dictionary<string, int>();

    protected override async Task OnParametersSetAsync()
    {
        _type = TypeQuery is not null && OccasionTypes.IsKnown(TypeQuery) ? TypeQuery : null;
        // The type in the address stays selectable though no occasion has it (yet).
        var options = await Library.GetFilterOptionsAsync();
        var present = options.EventTypes;
        _counts = options.EventTypeCounts;
        _types = _type is not null && !present.Contains(_type) ? [.. OccasionTypes.All.Where(t => t == _type || present.Contains(t))] : present;
        _page = await Library.GetOccasionsPageAsync(LibraryQueries.ParsePage(PageQuery), _type);
    }

    private string TypeOption(string type) =>
        $"{Text.EventTypeLabel(type)} ({_counts.GetValueOrDefault(type).ToString("N0", System.Globalization.CultureInfo.CurrentCulture)})";

    // Relative, so links work under whatever base path the app has; the type stays while paging.
    private string PageLink(int page)
    {
        var query = new Dictionary<string, string?>();
        if (_type is not null)
        {
            query["type"] = _type;
        }

        if (page > 1)
        {
            query["page"] = page.ToString(System.Globalization.CultureInfo.InvariantCulture);
        }

        return QueryHelpers.AddQueryString("occasions", query);
    }
}
