@page "/settings/export"
@using Sepiabox.Catalog
@using Sepiabox.Catalog.Search
@using Microsoft.Extensions.DependencyInjection
@inject IExportRequests Exports
@inject IFaceSettings Faces
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject TimeProvider Clock
@* Static server rendering with POST forms, as the settings page (S-022): asking is answered with a redirect back here and a
   note. The zip is written by the worker's export job within minutes; the page lists the requests and gives a one-hour
   link to each finished one (S-040, D-110). *@

<PageTitle>@Text["Export_Heading"] · Sepiabox</PageTitle>

<PageHead Title="@Text["Export_Heading"]">
    <Subtitle>@Text["Export_Intro"]</Subtitle>
</PageHead>
<p class="muted">@Text["Export_Contents"]</p>

@if (NoteText is { } note)
{
    <Notice Variant="@NoteVariant">@note</Notice>
}

<form method="post" @formname="request" @onsubmit="RequestAsync" class="export-request panel block">
    <AntiforgeryToken />
    @if (_faceRecognitionOn)
    {
        @* With recognition off there are no faces to export, and a face-data zip would be erased at once (D-110). *@
        <label>
            <input type="checkbox" name="IncludeFaceData" value="yes" />
            @Text["Export_IncludeFaces"]
        </label>
        <p class="hint muted">@Text["Export_IncludeFacesHint"]</p>
    }
    <div class="form-actions"><button type="submit" class="button">@Text["Export_Request"]</button></div>
</form>

@if (_requests is { Count: > 0 } requests)
{
    <SectionTitle Title="@Text["Export_History"]" Count="requests.Count" />
    <ul class="exports">
        @foreach (var request in requests)
        {
            <li class="export export-@request.Status">
                <span class="when">@When(request.RequestedAt)</span>
                <span class="status">@Text["Export_Status_" + request.Status]</span>
                @if (request.IncludeFaceData)
                {
                    <span class="faces muted">@Text["Export_WithFaces"]</span>
                }

                @if (request.Status == ExportStatuses.Done)
                {
                    <span class="size muted">@Text["Export_Done", request.Assets ?? 0, ByteSizes.Format(request.SizeBytes ?? 0)]</span>
                    @if (request.BlobName is null)
                    {
                        @* The export job deleted a zip with face data when face recognition was turned off (D-110). *@
                        <span class="removed muted">@Text["Export_Erased"]</span>
                    }
                    else if (ExportRequests.Expired(request, Clock.GetUtcNow()))
                    {
                        <span class="removed muted">@Text["Export_Expired", ExportRequest.RetentionDays]</span>
                    }
                    else
                    {
                        <a class="button" href="settings/export/@request.Id/download" aria-label="@Text["Export_DownloadAria", When(request.RequestedAt)]">@Text["Export_Download"]</a>
                        <span class="kept muted">@Text["Export_KeptUntil", When(ExportRequests.KeptUntil(request))]</span>
                        @if (request.FinishedAt is { } finished && finished.Add(ExportLinkHours) is var linksEnd && linksEnd > Clock.GetUtcNow())
                        {
                            <span class="links muted">@Text["Export_LinksUntil", When(linksEnd)]</span>
                        }
                    }
                }
                else if (request.Status == ExportStatuses.Failed)
                {
                    <span class="error">@request.Error</span>
                }
            </li>
        }
    </ul>
    <p class="muted small">@Text["Export_LinkHint"]</p>
}

<p><a href="settings">@Text["Export_Back"]</a></p>

@code {
    // What a note in the address may say, and its text: nothing else from the address is shown.
    private static readonly Dictionary<string, (string Key, string Variant)> s_notes = new(StringComparer.Ordinal)
    {
        ["requested"] = ("Export_Note_requested", NoticeVariant.Success),
        ["busy"] = ("Export_Note_busy", NoticeVariant.Warning),
        ["signed-out"] = ("Settings_Error_NoEmail", NoticeVariant.Error),
    };

    [SupplyParameterFromQuery(Name = "note")]
    public string? Note { get; set; }

    [SupplyParameterFromForm]
    public string? IncludeFaceData { get; set; }

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    // The links to the originals inside a zip last 24 hours from the moment it was written (ExportGenerator.OriginalLinkLifetime).
    private static readonly TimeSpan ExportLinkHours = TimeSpan.FromHours(24);

    private IReadOnlyList<ExportRequest>? _requests;
    private bool _faceRecognitionOn = true;

    private string? Email => HttpContext?.User.FindFirst(ClaimTypes.Email)?.Value;

    private string? NoteText => Note is not null && s_notes.TryGetValue(Note, out var known) ? Text[known.Key].Value : null;

    private string NoteVariant => Note is not null && s_notes.TryGetValue(Note, out var known) ? known.Variant : NoticeVariant.Success;

    protected override async Task OnInitializedAsync()
    {
        _requests = await Exports.RecentAsync();
        _faceRecognitionOn = (await Faces.GetAsync()).State.On;
    }

    private async Task RequestAsync()
    {
        if (Email is not { } email)
        {
            Navigation.NavigateTo("settings/export?note=signed-out");
            return;
        }

        // A form posted while recognition is off (the box was there when the page was opened) asks without face data.
        var asked = await Exports.RequestAsync(email, IncludeFaceData == "yes" && (await Faces.GetAsync()).State.On);
        Navigation.NavigateTo($"settings/export?note={(asked ? "requested" : "busy")}");
    }

    // In the library's time zone (Search:TimeZone), as the settings page shows its history.
    private string When(DateTimeOffset when)
    {
        var zone = Services.GetService<SearchOptions>()?.TimeZone ?? TimeZoneInfo.Utc;
        return TimeZoneInfo.ConvertTime(when, zone).ToString("g", System.Globalization.CultureInfo.CurrentCulture);
    }
}
