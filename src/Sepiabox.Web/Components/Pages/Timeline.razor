@page "/"
@using Microsoft.AspNetCore.WebUtilities
@using Sepiabox.Catalog.Search
@inject ILibraryQueries Library
@inject NavigationManager Navigation
@inject IQueryEmbedder Describer
@inject QuestionService Questions
@using Sepiabox.Search.Questions
@* Static server rendering (no @rendermode): plain HTML with links, a GET form for the filters and a POST form for a
   question, which the server answers with a redirect to the search it was understood as (S-025). *@

<PageTitle>Sepiabox</PageTitle>

<h1 class="visually-hidden">@Text["Timeline_Heading"]</h1>

@if (_options is { } options && QuestionBoxShown)
{
    <section class="panel finder">
    <form class="ask" method="post" action="./" @formname="ask" @onsubmit="AskAsync" role="search" aria-label="@Text["Ask_Label"]">
        <AntiforgeryToken />
        @* One pill-shaped field with the Ask button inside (S-067); the label stays for screen readers. *@
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2z" /></svg>
        <label class="ask-field">
            <span class="visually-hidden">@Text["Ask_Label"]</span>
            <input type="search" name="Question" value="@(Question ?? Asked)" maxlength="@QuestionPrompt.MaxQuestionLength" placeholder="@Text["Ask_Placeholder"]" disabled="@(!Questions.IsConfigured)" />
        </label>
        <button type="submit" class="button" disabled="@(!Questions.IsConfigured)">@Text["Ask_Submit"]</button>
        @* Always in the page, so a screen reader announces the text ask.js puts in it (D-101): the first question after an
           update can take about a minute. The texts are the script's, from the resources (D-050). *@
        <p class="ask-status" role="status" data-thinking="@Text["Ask_Thinking"]" data-slow="@Text["Ask_Slow"]" data-timeout="@Text["Ask_TimedOut"]"></p>
    </form>
    @if (Questions.IsConfigured)
    {
        @* One line; what leaves the server is behind a disclosure, so the first screen on a phone shows photos (S-067). *@
        <p class="hint muted">
            @Text["Ask_HintShort"]
            <details class="privacy"><summary>@Text["Ask_PrivacyLabel"]</summary><span>@Text["Ask_Hint"]</span></details>
        </p>
    }
    else
    {
        <p class="hint muted">@Text["Ask_NotConfigured"]</p>
    }
    @if (_askMessage is not null)
    {
        <p class="empty" role="alert">@_askMessage</p>
    }

    <FilterBar Options="options" Fields="SearchLinks.ToFields(_query)" Filtered="@(_filtered || _invalid)" OnThisDayActive="@(_query == SearchLinks.OnThisDay)" DescribeAvailable="Describer.IsAvailable" PeopleResetHref="@PeopleResetHref" />
    </section>
    @if (_filtered && _query is not null)
    {
        <QueryChips Query="_query" />
    }
}

@if (_invalid)
{
    <p class="empty" role="alert">@Text["Search_Invalid"] <a href="./">@Text["Filter_Clear"]</a></p>
}
else if (_describeUnavailable)
{
    <p class="empty" role="alert">@(_query?.Filters.SimilarToRegion is null ? Text["Search_DescribeUnavailable"] : Text["Region_Unavailable"]) <a href="./">@Text["Filter_Clear"]</a></p>
}
else if (_peopleMessage is not null)
{
    <p class="empty" role="alert">@_peopleMessage <a href="./">@Text["Filter_Clear"]</a></p>
}
else if (_filtered && _count is { } count)
{
    <AnswerCard Query="_query!" Count="count" />
}
else if (_filtered)
{
    @if (_query?.Aggregate is not null)
    {
        @* A count with a description is not a number in the MVP (D-070, D-075): its results instead. *@
        <p class="empty" role="status">@Text["Count_NeedsDescription"]</p>
    }
    @if (_results is null)
    {
        <p class="muted">@Text["Timeline_Loading"]</p>
    }
    else if (_results.Items.Count == 0)
    {
        <p class="empty">@Text["Search_NoResults"] <a href="./">@Text["Filter_Clear"]</a></p>
    }
    else if (_query?.Filters.SimilarToRegion is not null)
    {
        @* Photos like a part of a photo (S-041): by occasion, the occasion of the most similar photo first, and in each the
           most similar first. *@
        <h2 class="region-heading">@Text["Search_MostSimilarToRegion"]</h2>
        @foreach (var group in _groups)
        {
            <section class="month">
                <h3>
                    @if (group.Occasion is { } occasion)
                    {
                        <a href="occasions/@occasion.Id">@Text.OccasionTitle(occasion.PlaceLabel, occasion.StartsAt, occasion.EndsAt)</a>
                    }
                    else
                    {
                        @Text["Search_NotInOccasion"]
                    }
                </h3>
                <ul class="grid">
                    @foreach (var item in group.Items)
                    {
                        <li><MediaCard Item="item" Href="@DetailLink(item)" /></li>
                    }
                </ul>
            </section>
        }
        @if (_results.HasMore && SimilarSearch.More(_query) is { } moreRegion)
        {
            <p class="more"><a href="@SearchLinks.Timeline(moreRegion)">@Text["Similar_ShowMore"]</a></p>
        }
    }
    else if (_query?.Filters.Visual is not null || _query?.Filters.SimilarTo is not null)
    {
        @* Most similar first (S-016, S-017): grouping by month would hide that order. *@
        <section class="month">
            <h2>@(_query.Filters.SimilarTo is null ? Text["Search_MostSimilar"] : Text["Search_MostSimilarToPhoto"])</h2>
            <ul class="grid">
                @foreach (var item in _results.Items)
                {
                    <li><MediaCard Item="item" Href="@DetailLink(item)" /></li>
                }
            </ul>
        </section>
        @if (_query.Filters.SimilarTo is not null)
        {
            @* With no threshold there are always more similar ones: offer the next step, up to the DSL's maximum (D-086). *@
            @if (_results.HasMore && SimilarSearch.More(_query) is { } more)
            {
                <p class="more"><a href="@SearchLinks.Timeline(more)">@Text["Similar_ShowMore"]</a></p>
            }
        }
        else if (_results.HasMore)
        {
            <p class="more muted">@Text["Search_FirstResults", _results.Items.Count]</p>
        }
    }
    else
    {
        <MonthGroups Items="_results.Items" DetailLink="DetailLink" />
        @if (_results.HasMore)
        {
            <p class="more muted">@Text["Search_FirstResults", _results.Items.Count]</p>
        }
    }
}
else if (_page is null)
{
    <p class="muted">@Text["Timeline_Loading"]</p>
}
else if (_page.Items.Count == 0 && _page.Page == 1)
{
    <p class="empty">@Text["Timeline_EmptyBefore"] <code>sepiabox-ingest</code> @Text["Timeline_EmptyAfter"]</p>
}
else if (_page.Items.Count == 0)
{
    <p class="empty">@Text["Timeline_NoMore"] <a href="@PageLink(1)">@Text["Timeline_BackToStart"]</a></p>
}
else
{
    <MonthGroups Items="_page.Items" DetailLink="DetailLink" />

    <nav class="pages" aria-label="@Text["Timeline_Pages"]">
        @if (_page.Page > 1)
        {
            <a href="@PageLink(_page.Page - 1)">@Text["Timeline_Newer"]</a>
        }
        @if (_page.HasMore)
        {
            <a href="@PageLink(_page.Page + 1)">@Text["Timeline_Older"]</a>
        }
    </nav>
}

@code {
    // Text, not int: a hand-typed "abc" or 99999999999 must become a page, not a binding error.
    [SupplyParameterFromQuery(Name = "page")]
    public string? PageQuery { get; set; }

    /// <summary>The filters, as the search DSL in base64url (S-013).</summary>
    [SupplyParameterFromQuery(Name = SearchLinks.QueryParameter)]
    public string? SearchQueryParameter { get; set; }

    // The filter bar's fields, present only when it was submitted; the page turns them into ?q= at once.
    [SupplyParameterFromQuery(Name = "filter")]
    public string? FilterSubmitted { get; set; }

    [SupplyParameterFromQuery(Name = "year")]
    public string? Year { get; set; }

    [SupplyParameterFromQuery(Name = "month")]
    public string? Month { get; set; }

    [SupplyParameterFromQuery(Name = "kind")]
    public string? Kind { get; set; }

    [SupplyParameterFromQuery(Name = "city")]
    public string? City { get; set; }

    [SupplyParameterFromQuery(Name = "source")]
    public string? Source { get; set; }

    [SupplyParameterFromQuery(Name = "album")]
    public string? Album { get; set; }

    [SupplyParameterFromQuery(Name = "text")]
    public string? Description { get; set; }

    /// <summary>The people chosen in the filter bar (S-021), one "person" parameter each.</summary>
    [SupplyParameterFromQuery(Name = "person")]
    public string[]? People { get; set; }

    [SupplyParameterFromQuery(Name = "me")]
    public string? Me { get; set; }

    [SupplyParameterFromQuery(Name = "place")]
    public string[]? SavedPlaces { get; set; }

    /// <summary>The photo whose similar ones the bar narrows (S-017), carried in a hidden field.</summary>
    [SupplyParameterFromQuery(Name = SearchLinks.SimilarParameter)]
    public string? Similar { get; set; }

    [SupplyParameterFromQuery(Name = SearchLinks.SimilarLimitParameter)]
    public string? SimilarLimit { get; set; }

    /// <summary>The part of a photo whose similar ones the bar narrows (S-041), carried in hidden fields.</summary>
    [SupplyParameterFromQuery(Name = SearchLinks.RegionAssetParameter)]
    public string? RegionAsset { get; set; }

    [SupplyParameterFromQuery(Name = SearchLinks.RegionBoxParameter)]
    public string? RegionBox { get; set; }

    [SupplyParameterFromQuery(Name = SearchLinks.RegionLimitParameter)]
    public string? RegionLimit { get; set; }

    /// <summary>The occasions the bar narrows (S-023), carried in hidden fields.</summary>
    [SupplyParameterFromQuery(Name = SearchLinks.EventParameter)]
    public string[]? EventIds { get; set; }

    /// <summary>The number of sources the bar narrows (S-028), carried in hidden fields.</summary>
    [SupplyParameterFromQuery(Name = SearchLinks.SourceEqParameter)]
    public string? SourceEq { get; set; }

    [SupplyParameterFromQuery(Name = SearchLinks.SourceGteParameter)]
    public string? SourceGte { get; set; }

    /// <summary>The sharpness filter and including what was set aside (S-027), carried in hidden fields.</summary>
    [SupplyParameterFromQuery(Name = SearchLinks.BlurryParameter)]
    public string? Blurry { get; set; }

    [SupplyParameterFromQuery(Name = SearchLinks.HiddenParameter)]
    public string? IncludeHidden { get; set; }

    /// <summary>The question the search came from, shown again in the box (S-025).</summary>
    [SupplyParameterFromQuery(Name = AskedParameter)]
    public string? Asked { get; set; }

    /// <summary>The question box's text, on the form's POST.</summary>
    [SupplyParameterFromForm(FormName = "ask")]
    public string? Question { get; set; }

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    public const string AskedParameter = "asked";

    private TimelinePage? _page;
    private SearchPage? _results;
    private CountResult? _count;
    private FilterOptions? _options;
    private SearchQuery? _query;

    // "Reset" in the people picker: the same search without the names ("with me" stays, it has a pill of its own).
    private string PeopleResetHref => _query is null
        ? "./"
        : SearchLinks.Timeline(_query with { Filters = _query.Filters with { People = _query.Filters.People is { IncludeMe: true } ? new PeopleFilter { IncludeMe = true } : null } });
    private bool _filtered;
    private bool _invalid;
    private bool _describeUnavailable;
    private IReadOnlyList<OccasionGroup> _groups = [];
    private string? _peopleMessage;
    private bool _asked;

    // The question box is on the page: a library with something to show, a search, or a question asked.
    private bool QuestionBoxShown => _options is not null && (_filtered || _invalid || _asked || _page is { Items.Count: > 0 } || _page is { Page: > 1 });
    private string? _askMessage;

    protected override async Task OnParametersSetAsync()
    {
        // A question's POST is answered by AskAsync, which redirects or shows a message over the same page.
        if (HttpContext is not null && HttpMethods.IsPost(HttpContext.Request.Method) && Question is not null)
        {
            // The form must be on the page for Blazor to hand it the POST; the rest waits for the answer.
            _asked = true;
            _options = await Library.GetFilterOptionsAsync();
            return;
        }

        await LoadAsync();
        if (QuestionBoxShown)
        {
            // The question box is on the page: keep the question format warm in the background (D-101); it never waits.
            Questions.WarmUp();
        }
    }

    private async Task AskAsync()
    {
        var result = await Questions.AskAsync(Question, HttpContext?.User ?? new ClaimsPrincipal(), HttpContext?.RequestAborted ?? default);
        if (result is { Outcome: AskOutcome.Answered, Query: { } query } && (!query.Filters.IsEmpty || query.Aggregate is not null))
        {
            // Post, redirect, get: the search has its own address, and reloading it does not ask again.
            var asked = QuestionPrompt.Clean(Question) ?? string.Empty;
            Navigation.NavigateTo(SearchLinks.Timeline(query) + "&" + AskedParameter + "=" + Uri.EscapeDataString(asked));
            return;
        }

        _askMessage = result.Outcome switch
        {
            AskOutcome.Answered => Text["Ask_NothingToFilter"],
            AskOutcome.Invalid => Text["Ask_Invalid", QuestionPrompt.MaxQuestionLength],
            AskOutcome.NotConfigured => Text["Ask_NotConfigured"],
            AskOutcome.LimitReached => Text["Ask_LimitReached", Questions.DailyLimit],
            AskOutcome.NotUnderstood => Text["Ask_NotUnderstood"],
            AskOutcome.Unavailable => Text["Ask_Unavailable"],
            _ => Text["Ask_Failed"],
        };
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (FilterSubmitted is not null)
        {
            // One address per set of filters, so the URL can be copied and opened again.
            Navigation.NavigateTo(SearchLinks.Timeline(
                SearchLinks.FromFields(Year, Month, Kind, City, Source, Description, People, Me == "1", SavedPlaces, Similar, SimilarLimit, EventIds, SourceEq, SourceGte, RegionAsset, RegionBox, RegionLimit, Blurry, IncludeHidden, Album)));
            return;
        }

        (_page, _results, _query, _filtered, _invalid, _describeUnavailable, _count) = (null, null, null, false, false, false, null);
        _groups = [];
        _peopleMessage = null;
        if (!string.IsNullOrEmpty(SearchQueryParameter))
        {
            if (SearchQueryJson.TryDecode(SearchQueryParameter, out var query, out _))
            {
                _query = query;
                _filtered = !query.Filters.IsEmpty || query.Aggregate is not null;
            }
            else
            {
                _invalid = true;
            }
        }

        _options = await Library.GetFilterOptionsAsync();
        if (_filtered)
        {
            try
            {
                // A count answers with a number (S-026); one with a description, with its results.
                _count = _query!.Aggregate is null ? null : await Library.CountAsync(_query);
                if (_count is null)
                {
                    _results = await Library.SearchAsync(_query);
                    if (_query.Filters.SimilarToRegion is not null)
                    {
                        var occasionOf = await Library.GetOccasionsOfAsync([.. _results.Items.Select(i => i.Id)]);
                        _groups = OccasionGroups.Group(_results.Items, occasionOf);
                    }
                }
            }
            catch (VisualSearchUnavailableException)
            {
                // The text model is missing or failed to load: say so, and keep the bar's other filters usable.
                _describeUnavailable = true;
            }
            catch (UnknownPeopleException unknown)
            {
                // A name that is no one's (any more), or "me" without "This is me" (S-021).
                _peopleMessage = PeopleSearch.Message(unknown, Text);
            }
            catch (UnknownPlacesException unknown)
            {
                // A saved place that is not there (any more), or "from home" with no home (S-014).
                _peopleMessage = PlacesSearch.Message(unknown, Text);
            }
            catch (AssetNotAnalysedException missing)
            {
                // "Similar" on a photo without an embedding yet, or a link to one no longer in the catalog (S-017).
                _peopleMessage = SimilarSearch.Message(missing, Text);
            }
        }
        else if (!_invalid)
        {
            _page = await Library.GetTimelinePageAsync(LibraryQueries.ParsePage(PageQuery));
        }
    }

    // Relative, keeping any other query parameters, so links work under whatever base path the app has.
    private string PageLink(int page)
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query)
            .Where(p => !string.Equals(p.Key, "page", StringComparison.OrdinalIgnoreCase))
            .SelectMany(p => p.Value, (p, value) => new KeyValuePair<string, string?>(p.Key, value))
            .ToList();
        if (page > 1)
        {
            query.Add(new("page", page.ToString(System.Globalization.CultureInfo.InvariantCulture)));
        }

        return QueryHelpers.AddQueryString("./", query);
    }

    // The detail page's "back" returns to the same filters (written again from the parsed query, never copied from
    // the address) or the same page.
    private string DetailLink(TimelineItem item) =>
        _filtered ? $"photos/{item.Id}?{SearchLinks.QueryParameter}={SearchQueryJson.Encode(_query!)}"
        : _page is { Page: > 1 } page ? $"photos/{item.Id}?page={page.Page}"
        : $"photos/{item.Id}";
}
