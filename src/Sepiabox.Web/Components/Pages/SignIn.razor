@page "/sign-in"
@attribute [AllowAnonymous]
@inject SignInProviders Providers
@inject IAuthorizationService Authorization
@inject IAuthorizationPolicyProvider Policies
@inject IWebHostEnvironment Environment
@inject NavigationManager Navigation
@* Static server rendering: the buttons are plain links that leave for Google or Microsoft. *@

<PageTitle>@Text["SignIn_Title"] · Sepiabox</PageTitle>

<AuthCard>
    <h1>@Text["SignIn_Title"]</h1>
    <p>@Text["SignIn_Text"]</p>

    @if (Error is not null)
    {
        <Notice Variant="@NoticeVariant.Error">@Text["SignIn_Failed"]</Notice>
    }

    @if (Providers.Any)
    {
        <div class="providers">
            @if (Providers.Google is not null)
            {
                <a class="button secondary provider" href="@ProviderLink(SignInProviders.GoogleRoute)" data-enhance-nav="false"><svg class="icon provider-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21.35 11.1H12v2.9h5.35c-.5 2.4-2.6 3.7-5.35 3.7a6 6 0 1 1 0-12c1.5 0 2.8.5 3.8 1.4l2.1-2.1A9 9 0 1 0 12 21c5.2 0 8.6-3.6 8.6-8.8 0-.4 0-.8-.1-1.1z" fill="currentColor" stroke="none" /></svg><span>@Text["SignIn_WithGoogle"]</span></a>
            }
            @if (Providers.Microsoft is not null)
            {
                <a class="button secondary provider" href="@ProviderLink(SignInProviders.MicrosoftRoute)" data-enhance-nav="false"><svg class="icon provider-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h8.5v8.5H3zM12.5 3H21v8.5h-8.5zM3 12.5h8.5V21H3zM12.5 12.5H21V21h-8.5z" fill="currentColor" stroke="none" /></svg><span>@Text["SignIn_WithMicrosoft"]</span></a>
            }
        </div>
    }
    else if (Environment.IsDevelopment())
    {
        <form class="dev-login" method="post" action="dev-login" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@Return" />
            <label for="email">@Text["SignIn_DevEmail"]</label>
            <input id="email" name="email" type="email" required />
            <button type="submit" class="button">@Text["SignIn_Title"]</button>
        </form>
    }
    else
    {
        <p class="empty">@Text["SignIn_NotConfigured"]</p>
    }

    <p class="auth-privacy muted small">@Text["SignIn_Privacy"]</p>
</AuthCard>

@code {
    // The page is rendered statically on the server (no @rendermode), so the request is always there.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    // The cookie handler names it ReturnUrl when it sends a visitor here.
    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = AuthSetup.SignInErrorQuery)]
    private string? Error { get; set; }

    private string Return => AuthSetup.LocalReturnUrl(
        HttpContext?.Request ?? throw new InvalidOperationException("/sign-in is only rendered on the server."),
        ReturnUrl);

    protected override async Task OnInitializedAsync()
    {
        // Someone who already has access (the same policy as every page) has nothing to do here.
        if (AuthenticationState is not null
            && await Policies.GetDefaultPolicyAsync() is { } policy
            && (await Authorization.AuthorizeAsync((await AuthenticationState).User, policy)).Succeeded)
        {
            Navigation.NavigateTo(Return);
        }
    }

    private string ProviderLink(string provider) =>
        $"sign-in/{provider}?returnUrl={Uri.EscapeDataString(Return)}";
}
