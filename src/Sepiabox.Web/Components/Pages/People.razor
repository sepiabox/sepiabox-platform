@page "/people"
@inject ILibraryQueries Library
@inject IFaceSettings Faces
@* Static server rendering, as the timeline: the people faces were grouped into (S-019), the named ones first and the ones that
   need a name after them with a callout that counts them (S-069). Naming them is S-020. *@

<PageTitle>@Text["People_Heading"] · Sepiabox</PageTitle>

<PageHead Title="@Text["People_Heading"]">
    <Subtitle>@Text["People_Subtitle"]</Subtitle>
</PageHead>

@if (Note == "deleted")
{
    <Notice>@Text["People_Done_Deleted"]</Notice>
}
else if (Note == "ignored")
{
    <p class="note" role="status">@Text["People_Done_Ignored"]</p>
}

@if (_off)
{
    <p class="note faces-off">@Text["People_FacesOff"] <a href="settings">@Text["Layout_Settings"]</a></p>
}
else if (_people is { Count: > 0 })
{
    @if (_fewFaces > 0)
    {
        @* Opens a confirmation; strangers (posters, crowds) seen once or twice are deleted for good there (#107). *@
        <p class="ignore-many"><a href="people/ignore" class="button secondary" data-enhance-nav="false">@(_fewFaces == 1 ? Text["People_IgnoreMany_One"] : Text["People_IgnoreMany_Other", _fewFaces])</a></p>
    }

    @if (_unnamed.Count > 0)
    {
        <Callout>@(_unnamed.Count == 1 ? Text["People_NeedName_One"] : Text["People_NeedName_Other", _unnamed.Count.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)])</Callout>
    }

    @if (_named.Count > 0)
    {
        @if (_unnamed.Count > 0)
        {
            <SectionTitle Title="@Text["People_Named"]" Count="_named.Count" />
        }
        <PeopleGrid People="_named" />
    }

    @if (_unnamed.Count > 0)
    {
        <SectionTitle Title="@Text["People_NeedsName"]" Count="_unnamed.Count" />
        <PeopleGrid People="_unnamed" />
    }
}
else
{
    <p class="empty">@Text["People_None"]</p>
}

@code {
    private IReadOnlyList<PersonSummary>? _people;
    private IReadOnlyList<PersonSummary> _named = [];
    private IReadOnlyList<PersonSummary> _unnamed = [];
    private bool _off;
    private int _fewFaces;

    // Only "deleted" is shown; nothing else from the address.
    [SupplyParameterFromQuery(Name = PersonLinks.NoteParameter)]
    public string? Note { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _off = !(await Faces.GetAsync()).State.On;
        _people = _off ? [] : await Library.GetPeopleAsync();
        _named = _people.Where(p => p.Name is not null).ToList();
        _unnamed = _people.Where(p => p.Name is null).ToList();
        _fewFaces = _off ? 0 : await Faces.CountUnnamedWithFewFacesAsync();
    }
}
