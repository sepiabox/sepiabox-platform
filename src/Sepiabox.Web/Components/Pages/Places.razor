@page "/places"
@inject ISavedPlaces SavedPlaceList
@inject ILibraryQueries Library
@inject NavigationManager Navigation
@using System.Globalization
@using Sepiabox.Catalog.Search
@using Sepiabox.Catalog.SavedPlaces
@* The family's places (S-014, D-083), in static server rendering with POST forms: a change that worked is answered
   with a redirect back here and a note, as the person page (S-020); one that did not is shown again with what was
   typed and why. A photo's "Save this place" opens it with the photo's coordinates filled in. *@

<PageTitle>@Text["Places_Heading"] · Sepiabox</PageTitle>

<h1 class="page-heading">@Text["Places_Heading"]</h1>

@if (NoteText is { } note)
{
    <p class="note" role="status">@note</p>
}

@if (_deleting is { } deleting)
{
    <section class="confirm-delete">
        <p class="note">@Text["Places_DeleteExplain", deleting.Name]</p>
        <form method="post" @formname="delete" @onsubmit="DeleteAsync" class="confirm">
            <AntiforgeryToken />
            <input type="hidden" name="DeleteId" value="@deleting.Id.ToString(CultureInfo.InvariantCulture)" />
            <button type="submit">@Text["Places_DeleteConfirm"]</button>
            <a href="places">@Text["Settings_Cancel"]</a>
        </form>
    </section>
}

<section class="new-place">
    <h2>@Text["Places_New"]</h2>
    <form method="post" @formname="create" @onsubmit="CreateAsync" class="create">
        <AntiforgeryToken />
        <label>
            <span>@Text["Places_Name"]</span>
            <input type="text" name="NewName" value="@NewName" maxlength="@SavedPlaceEditor.MaxNameLength" required />
            <span class="hint muted small name-hint">@Text["Places_NameHint"]</span>
        </label>
        <label>
            <span>@Text["Places_CoordinatesLabel"]</span>
            <input type="text" name="NewCoordinates" value="@(NewCoordinates ?? _photoCoordinates)" placeholder="38.72, -9.13" required />
        </label>
        <label>
            <span>@Text["Places_Radius"]</span>
            <input type="number" name="NewRadius" min="@SavedPlaceEditor.MinRadiusM" max="@SavedPlaceEditor.MaxRadiusM" value="@(NewRadius ?? SavedPlaceEditor.DefaultRadiusM.ToString(CultureInfo.InvariantCulture))" />
        </label>
        <label class="home">
            <input type="checkbox" name="NewHome" value="1" checked="@(NewHome == "1")" />
            <span>@Text["Places_IsHome"]</span>
        </label>
        <button type="submit">@Text["Places_Save"]</button>
    </form>
    <p class="hint muted">@Text["Places_Hint"]</p>
</section>

@if (_places is { Count: > 0 } places)
{
    <p class="hint muted cannot-move">@Text["Places_CannotMove"]</p>
    <ul class="saved-places">
        @foreach (var place in places)
        {
            var failed = _failedEdit == place.Id;
            <li class="saved-place">
                <h2>
                    @place.Name
                    @if (place.IsHome)
                    {
                        @(" ")<span class="home-mark">@Text["Places_HomeMark"]</span>
                    }
                </h2>
                <p class="muted small coordinates">@Coordinates(place)</p>
                <p class="links">
                    <a href="@SearchLinks.Timeline(Photos(place))">@Text["Places_Photos"]</a>
                    <a href="@SearchLinks.Timeline(OverTheYears(place))" class="over-the-years">@Text["Places_OverTheYears"]</a>
                </p>
                @* One form name per place: a page's forms must have different names. *@
                <form method="post" @formname="@($"edit-{place.Id.ToString(CultureInfo.InvariantCulture)}")" @onsubmit="() => UpdateAsync(place.Id)" class="edit">
                    <AntiforgeryToken />
                    <label>
                        <span>@Text["Places_Name"]</span>
                        <input type="text" name="EditName" value="@(failed ? EditName : place.Name)" maxlength="@SavedPlaceEditor.MaxNameLength" required />
                        <span class="hint muted small name-hint">@Text["Places_NameHint"]</span>
                    </label>
                    <label>
                        <span>@Text["Places_Radius"]</span>
                        <input type="number" name="EditRadius" min="@SavedPlaceEditor.MinRadiusM" max="@SavedPlaceEditor.MaxRadiusM" value="@(failed ? EditRadius : place.RadiusM.ToString(CultureInfo.InvariantCulture))" />
                    </label>
                    <label class="home">
                        <input type="checkbox" name="EditHome" value="1" checked="@(failed ? EditHome == "1" : place.IsHome)" />
                        <span>@Text["Places_IsHome"]</span>
                    </label>
                    <button type="submit">@Text["Places_Update"]</button>
                    <a href="places?delete=@place.Id.ToString(CultureInfo.InvariantCulture)" class="small delete">@Text["Places_Delete"]</a>
                </form>
            </li>
        }
    </ul>
}
else
{
    <p class="empty">@Text["Places_None"]</p>
}

@code {
    // What a note in the address may say, and its text: nothing else from the address is shown.
    private static readonly Dictionary<string, string> s_notes = new(StringComparer.Ordinal)
    {
        ["created"] = "Places_Done_Created",
        ["updated"] = "Places_Done_Updated",
        ["deleted"] = "Places_Done_Deleted",
        [nameof(SavedPlaceOutcome.NotFound)] = "Places_Error_NotFound",
        [nameof(SavedPlaceOutcome.NameTaken)] = "Places_Error_NameTaken",
        [nameof(SavedPlaceOutcome.NameInvalid)] = "Places_Error_NameInvalid",
        [nameof(SavedPlaceOutcome.LocationInvalid)] = "Places_Error_LocationInvalid",
        [nameof(SavedPlaceOutcome.RadiusInvalid)] = "Places_Error_RadiusInvalid",
    };

    [SupplyParameterFromQuery(Name = PersonLinks.NoteParameter)]
    public string? Note { get; set; }

    /// <summary>From a photo's "Save this place": the photo, whose coordinates fill the form.</summary>
    [SupplyParameterFromQuery(Name = "asset")]
    public string? AssetId { get; set; }

    /// <summary>The place whose deletion is asked: a confirmation shows first.</summary>
    [SupplyParameterFromQuery(Name = "delete")]
    public long? Delete { get; set; }

    [SupplyParameterFromForm(FormName = "create")]
    public string? NewName { get; set; }

    [SupplyParameterFromForm(FormName = "create")]
    public string? NewCoordinates { get; set; }

    [SupplyParameterFromForm(FormName = "create")]
    public string? NewRadius { get; set; }

    [SupplyParameterFromForm(FormName = "create")]
    public string? NewHome { get; set; }

    // Bound from whichever place's form was sent (each has its own name).
    [SupplyParameterFromForm]
    public string? EditName { get; set; }

    [SupplyParameterFromForm]
    public string? EditRadius { get; set; }

    [SupplyParameterFromForm]
    public string? EditHome { get; set; }

    [SupplyParameterFromForm(FormName = "delete")]
    public string? DeleteId { get; set; }

    private IReadOnlyList<SavedPlaceSummary>? _places;
    private SavedPlaceSummary? _deleting;
    private string? _photoCoordinates;
    private SavedPlaceOutcome? _failure;
    private long? _failedEdit;

    private string? NoteText
    {
        get
        {
            var key = _failure is { } failure ? s_notes[failure.ToString()] : Note is not null && s_notes.TryGetValue(Note, out var known) ? known : null;
            return key switch
            {
                null => null,
                "Places_Error_RadiusInvalid" => Text[key, SavedPlaceEditor.MinRadiusM, SavedPlaceEditor.MaxRadiusM].Value,
                "Places_Error_NameInvalid" => Text[key, SavedPlaceEditor.MaxNameLength].Value,
                _ => Text[key].Value,
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _places = await SavedPlaceList.ListAsync();
        _deleting = Delete is { } id ? _places.FirstOrDefault(p => p.Id == id) : null;
        if (AssetId is { Length: > 0 } assetId && (await Library.GetAssetAsync(assetId))?.Location is var (latitude, longitude))
        {
            _photoCoordinates = string.Create(CultureInfo.InvariantCulture, $"{latitude:0.######}, {longitude:0.######}");
        }
    }

    private string Coordinates(SavedPlaceSummary place) =>
        Text[
            "Places_Coordinates",
            place.Latitude.ToString("0.#####", CultureInfo.CurrentCulture),
            place.Longitude.ToString("0.#####", CultureInfo.CurrentCulture),
            place.RadiusM.ToString("N0", CultureInfo.CurrentCulture)].Value;

    private static SearchQuery Photos(SavedPlaceSummary place) =>
        new() { Filters = new SearchFilters { SavedPlaces = [place.Name] } };

    // Grouped by year, each year linking to its photos (S-026's count rows).
    private static SearchQuery OverTheYears(SavedPlaceSummary place) =>
        Photos(place) with { Aggregate = new SearchAggregate { GroupBy = SearchGroupBy.Year } };

    private async Task CreateAsync()
    {
        var outcome = PlaceCoordinates.TryParse(NewCoordinates) is not { } point
            ? SavedPlaceOutcome.LocationInvalid
            : !TryRadius(NewRadius, SavedPlaceEditor.DefaultRadiusM, out var radius)
                ? SavedPlaceOutcome.RadiusInvalid
                : await SavedPlaceList.CreateAsync(NewName, point.Latitude, point.Longitude, radius!.Value, NewHome == "1");
        await AnswerAsync(outcome, "created", null);
    }

    private async Task UpdateAsync(long id)
    {
        // A blank radius keeps the place's own.
        var outcome = !TryRadius(EditRadius, null, out var radius)
            ? SavedPlaceOutcome.RadiusInvalid
            : await SavedPlaceList.UpdateAsync(id, EditName, radius, EditHome == "1");
        await AnswerAsync(outcome, "updated", id);
    }

    private async Task DeleteAsync()
    {
        var outcome = long.TryParse(DeleteId, NumberStyles.None, CultureInfo.InvariantCulture, out var id)
            ? await SavedPlaceList.DeleteAsync(id)
            : SavedPlaceOutcome.NotFound;
        await AnswerAsync(outcome, "deleted", null);
    }

    // Done: back to the page with a note. Refused: the same page again, with what was typed and why.
    private async Task AnswerAsync(SavedPlaceOutcome outcome, string done, long? editing)
    {
        if (outcome == SavedPlaceOutcome.Done || outcome == SavedPlaceOutcome.NotFound)
        {
            Navigation.NavigateTo($"places?{PersonLinks.NoteParameter}={(outcome == SavedPlaceOutcome.Done ? done : outcome.ToString())}");
            return;
        }

        _failure = outcome;
        _failedEdit = editing;
        _places = await SavedPlaceList.ListAsync();
    }

    // A whole number of metres, or blank for blankRadius (null keeps a place's own); false for anything else.
    private static bool TryRadius(string? value, int? blankRadius, out int? radius)
    {
        radius = blankRadius;
        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        var parsed = int.TryParse(value.Trim(), NumberStyles.None, CultureInfo.InvariantCulture, out var metres);
        radius = parsed ? metres : null;
        return parsed;
    }
}
