@* A video on the detail page. The sources are the web's own media addresses, which redirect to a freshly
   signed storage link (D-039, D-049), so the page never holds a link that could expire while it is open.
   wwwroot/video.js retries a network or source failure with a fresh link (not a decoding error or an
   abort), allows another retry only after 30 seconds of played time, at most 3 per player, and otherwise
   reveals the error message, which it reads from data-message in the page's language (D-049, D-050).
   It changes the video's src in the browser, so this component must stay static server rendering: an
   interactive render, or enhanced navigation's DOM merge when the same page is loaded again, would put
   the original src back, and the retry with it. *@

@if (HasProxy)
{
    <div class="player">
        <video data-player controls preload="metadata" playsinline aria-label="@Label"
               src="photos/@AssetId/@(ProxyName ?? DerivativeNames.Proxy)" poster="@PosterUrl"></video>
        @* Empty, and so hidden by CSS, until video.js fills it; screen readers announce the text as it appears. *@
        <p class="player-error" role="alert" data-message="@Text["Video_PlaybackFailed"]"></p>
    </div>
}
else
{
    @if (PosterUrl is { } poster)
    {
        <img src="@poster" alt="@Label" />
    }
    <p class="processing">@Text["Video_Processing"]</p>
}

@code {
    [Parameter, EditorRequired]
    public string AssetId { get; set; } = string.Empty;

    /// <summary>What the video is, for screen readers: the player has no visible title of its own.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>The poster derivative, or null when the video has none yet.</summary>
    [Parameter]
    public string? PosterName { get; set; }

    /// <summary>The playable version to use (S-064): <c>proxy-1080p</c> or <c>proxy-720p</c>; the 720p one when not given.</summary>
    [Parameter]
    public string? ProxyName { get; set; }

    /// <summary>Whether a playable version exists; until it does, there is nothing the browser can play.</summary>
    [Parameter]
    public bool HasProxy { get; set; }

    private string? PosterUrl => PosterName is { } name ? $"photos/{AssetId}/{name}" : null;
}
