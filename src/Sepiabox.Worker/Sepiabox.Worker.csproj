<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>sepiabox-worker</AssemblyName>
    <RootNamespace>Sepiabox.Worker</RootNamespace>
    <!-- azd builds the migrate job's image with the SDK's container support, which a console app opts into. -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Storage.Blobs" Version="13.6.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sepiabox.Catalog\Sepiabox.Catalog.csproj" />
    <ProjectReference Include="..\Sepiabox.Pipeline\Sepiabox.Pipeline.csproj" />
    <!-- Only for CLIP's text model, which events classify embeds the occasion types' prompts with (S-024). -->
    <ProjectReference Include="..\Sepiabox.Search\Sepiabox.Search.csproj" />
    <ProjectReference Include="..\Sepiabox.ServiceDefaults\Sepiabox.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sepiabox.Worker.Tests" />
  </ItemGroup>

</Project>
