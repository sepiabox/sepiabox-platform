<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>sepiabox-worker</AssemblyName>
    <RootNamespace>Sepiabox.Worker</RootNamespace>
    <!-- azd builds the migrate job's image with the SDK's container support, which a console app opts into. -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Security.KeyVault" Version="13.6.1" />
    <PackageReference Include="Aspire.Azure.Storage.Blobs" Version="13.6.1" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.4" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.4" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.77.0.4301" />
    <!-- The data protection packages bring versions of these with known vulnerabilities; the web gets the patched ones through its sign-in packages. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sepiabox.Catalog\Sepiabox.Catalog.csproj" />
    <ProjectReference Include="..\Sepiabox.Pipeline\Sepiabox.Pipeline.csproj" />
    <!-- Only for CLIP's text model, which events classify embeds the occasion types' prompts with (S-024). -->
    <ProjectReference Include="..\Sepiabox.Search\Sepiabox.Search.csproj" />
    <ProjectReference Include="..\Sepiabox.ServiceDefaults\Sepiabox.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Sepiabox.Storage\Sepiabox.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sepiabox.Worker.Tests" />
  </ItemGroup>

</Project>
