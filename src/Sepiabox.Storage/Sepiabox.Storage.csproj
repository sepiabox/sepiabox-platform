<Project Sdk="Microsoft.NET.Sdk">

  <!-- Blob storage and the blob-created queue behind the project's own interfaces (S-050, D-051): the Azure
       implementations are in the Sepiabox.Storage.Azure namespace, and nothing else references Azure.Storage or
       Azure.Messaging. No media libraries, so the web can reference it without Sepiabox.Pipeline (D-038). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sepiabox.Storage.Tests" />
    <InternalsVisibleTo Include="Sepiabox.Worker.Tests" />
  </ItemGroup>

</Project>
