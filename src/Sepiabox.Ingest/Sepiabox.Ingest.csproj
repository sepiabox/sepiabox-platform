<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>sepiabox-ingest</AssemblyName>
    <RootNamespace>Sepiabox.Ingest</RootNamespace>
    <!-- ICU on, unlike the rest of the build (Directory.Build.props): on Windows, .NET finds a time zone by its IANA id
         (the time-zone option of process, S-045, D-104) only through ICU. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sepiabox.Pipeline\Sepiabox.Pipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sepiabox.Ingest.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

</Project>
