  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\UnixFactAttribute.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sepiabox.AppHost\Sepiabox.AppHost.csproj" />
  </ItemGroup>

</Project>
