<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Like the web itself: the UI is rendered in en and pt-BR (D-058). -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.12.5" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- The web's data protection packages bring these at 10.0.10 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx,
         GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83). The web itself takes them from the
         ASP.NET Core framework; this project, without that framework reference, pins the patched releases. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="Testcontainers.Azurite" Version="4.16.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Bunit" />
    <Using Include="Sepiabox.Tests.Catalog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sepiabox.Web\Sepiabox.Web.csproj" />
    <!-- Only to check that the web's container names match what upload writes. -->
    <ProjectReference Include="..\..\src\Sepiabox.Pipeline\Sepiabox.Pipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Catalog\*.cs" LinkBase="Shared\Catalog" />
  </ItemGroup>

</Project>
