<Project Sdk="Microsoft.NET.Sdk">

  <!-- The MVP's end-to-end acceptance (S-054, D-076): ingest, upload, import and the web's questions in one test, so it
       references the ingest, the worker and the web together, which no per-project test project does. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Like the web: answers are worded in en and pt-BR (D-058). -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- As in Sepiabox.Web.Tests: the web's data protection packages bring these at 10.0.10, with known advisories. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="Testcontainers.Azurite" Version="4.16.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Sepiabox.Tests.Shared" />
    <Using Include="Sepiabox.Tests.Catalog" />
    <Using Include="Sepiabox.Tests.Places" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sepiabox.Ingest\Sepiabox.Ingest.csproj" />
    <ProjectReference Include="..\..\src\Sepiabox.Worker\Sepiabox.Worker.csproj" />
    <ProjectReference Include="..\..\src\Sepiabox.Web\Sepiabox.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\FixtureLibrary.cs" LinkBase="Shared" />
    <Compile Include="..\Shared\TempFolder.cs" LinkBase="Shared" />
    <Compile Include="..\Shared\TestModels.cs" LinkBase="Shared" />
    <Compile Include="..\Shared\Catalog\*.cs" LinkBase="Shared\Catalog" />
    <Compile Include="..\Shared\Live\*.cs" LinkBase="Shared\Live" />
    <!-- The synthetic GeoNames sample the fixture's locations resolve against (S-012, S-061). -->
    <Compile Include="..\Shared\Places\*.cs" LinkBase="Shared\Places" />
  </ItemGroup>

</Project>
